<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FemVoiceStudio</RootNamespace>
    <AssemblyName>FemVoice.Audio.Windows</AssemblyName>
    <!-- Capture is Windows-only at runtime (NAudio WASAPI/WaveIn/MMDevice). This flag lets the
         project COMPILE on Linux/CI (no Desktop workload needed — there is no WPF here); it does
         NOT make capture run on Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FemVoice.Core\FemVoice.Core.csproj" />
    <ProjectReference Include="..\FemVoice.Audio.Abstractions\FemVoice.Audio.Abstractions.csproj" />
  </ItemGroup>

</Project>
