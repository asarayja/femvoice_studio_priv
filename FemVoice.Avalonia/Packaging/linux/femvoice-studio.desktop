[Desktop Entry]
# Linux desktop entry for FemVoice Studio. The default dotnet build/publish does NOT consume or
# install this file; it is installed under /usr/share/applications only by the .deb helper
# (Packaging/linux/package-deb.sh). Exec resolves the /usr/bin/femvoice-studio launcher (which runs
# the app via `dotnet`). No runtime behaviour, no permissions.
Type=Application
Name=FemVoice Studio
Comment=Voice feminization training (Avalonia desktop preview — display-only)
Exec=femvoice-studio
Icon=femvoice-studio
Terminal=false
Categories=Education;Audio;
StartupNotify=true
