<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.AnalysisView">
  <!-- Display-only Analysis/Resonance scaffold: converter-free mini bar-charts over SYNTHETIC in-memory
       sample data, + static summary placeholders. No third-party charting, no converters, no database/saved state. -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>

      <!-- Sample-data / not-persisted banner -->
      <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBlock Text="{Binding SampleDataNotice}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- One card per synthetic series -->
      <ItemsControl ItemsSource="{Binding Series}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:AnalysisSeries">
            <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="14" Margin="0,0,0,10" Background="{DynamicResource ShellPanelBackgroundBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
                <!-- Converter-free mini bar-chart: bottom-aligned rectangles, Height = px sample value -->
                <Border Background="#11151c" CornerRadius="4" Height="120" ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding Bars}" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Rectangle Width="6" Margin="2,0" Fill="{DynamicResource ShellAccentBrush}" VerticalAlignment="Bottom" Height="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Summary metrics (static placeholders) -->
      <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6"
              Padding="14" Background="{DynamicResource ShellPanelBackgroundBrush}">
        <StackPanel Spacing="4">
          <TextBlock Text="Sammendrag (eksempel)" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <ItemsControl ItemsSource="{Binding SummaryMetrics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:AnalysisSummaryMetric">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource ShellMutedBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Deferred analysis actions (inert: disabled, no command) -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Importer analyse (senere)" IsEnabled="False" Padding="10,4"/>
        <Button Content="Eksporter analyse (senere)" IsEnabled="False" Padding="10,4"/>
      </StackPanel>

      <TextBlock Text="Analyse/resonans er en visning-bare plassholder med eksempeldata — ingen ekte analyse, lagring eller eksport."
                 Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
