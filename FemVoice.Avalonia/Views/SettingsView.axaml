<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.SettingsView">
  <!-- Display-only Settings scaffold: cards + inert rows. All interactive controls are IsEnabled=False with
       no command/binding (no side effects). Colours use the shell theme brushes; no value converters. -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>

      <!-- Deferred banner -->
      <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBlock Text="{Binding DeferredBanner}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- One card per settings section -->
      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SettingsSection">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SettingsRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource ShellBodyTextBrush}" VerticalAlignment="Center"/>
                        <!-- Inert: disabled control bound to nothing; status text conveys 'deferred'. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Value}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" VerticalAlignment="Center"/>
                          <Button Content="…" IsEnabled="{Binding IsEnabled}" Padding="10,2" MinWidth="40"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Innstillinger er en visning-bare plassholder i denne fasen — ingen handlinger er aktive."
                 Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
