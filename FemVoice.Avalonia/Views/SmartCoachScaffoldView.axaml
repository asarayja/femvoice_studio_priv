<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FemVoice.Avalonia.Views.SmartCoachScaffoldView">
  <!-- DEFERRED, display-only SmartCoach scaffold. Mirrors the WPF SmartCoachDashboardView visual structure
       (today's-focus card + streak/sessions/health tiles) with SYNTHETIC "—" placeholders and a disabled
       action. No engine, no scoring, no recommendations, no persistence. Dark baseline. -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">

      <!-- Header: title + deferred badge -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{DynamicResource ShellHeadingBrush}"/>
        <Border Classes="chip" VerticalAlignment="Center">
          <TextBlock Text="{Binding DeferredBadge}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="11"/>
        </Border>
      </StackPanel>
      <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>

      <!-- Today's focus card -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding TodayFocusLabel}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <Border Classes="chip" VerticalAlignment="Center">
              <TextBlock Text="{Binding TodayFocusValue}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="11"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding TodayRecommendation}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
        </StackPanel>
      </Border>

      <!-- Stat tiles: streak / sessions / health (synthetic "—") -->
      <Grid ColumnDefinitions="*,*,*" Margin="0">
        <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Placeholder}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ShellAccentBrush}"/>
            <TextBlock Text="{Binding StreakLabel}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" Margin="6,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Placeholder}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ShellAccentBrush}"/>
            <TextBlock Text="{Binding SessionsLabel}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Margin="6,0,0,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Placeholder}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ShellSuccessBrush}"/>
            <TextBlock Text="{Binding HealthLabel}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="{Binding SyntheticNote}" FontSize="11" Foreground="{DynamicResource ShellFaintBrush}"/>

      <!-- Read-only safety note -->
      <Border Classes="card">
        <TextBlock Text="{Binding SafetyNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- Disabled action (deferred) -->
      <Button Classes="primary" Content="{Binding ActionLabel}" IsEnabled="{Binding ActionEnabled}" HorizontalAlignment="Left"/>

      <TextBlock Text="{Binding Footnote}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ShellFaintBrush}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
