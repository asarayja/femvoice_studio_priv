<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FemVoice.Avalonia.Views.ExerciseRuntimeView">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="← Tilbake" Command="{Binding BackCommand}"/>
        <TextBlock Text="{Binding SelectedExerciseName}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Exercise metadata -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="12">
        <WrapPanel>
          <TextBlock Text="{Binding Category, StringFormat='Kategori: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding Difficulty, StringFormat='Nivå: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding TargetPitchText, StringFormat='Målområde: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding ElapsedText, StringFormat='Tid: {0}'}" Margin="0,0,20,4"/>
        </WrapPanel>
      </Border>

      <!-- Target profile (read-only, display-only — from shared ExerciseTargetProfile) -->
      <Border BorderBrush="#36c" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Mål-profil" FontWeight="SemiBold" Foreground="#9bf"/>
          <TextBlock Text="{Binding TargetProfile.ProfileStatusMessage}" Foreground="#bbb"/>
          <WrapPanel>
            <TextBlock Text="{Binding TargetProfile.TargetPitch, StringFormat='Mål-pitch: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.ResonanceTarget, StringFormat='Resonans-mål: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.StabilityTarget, StringFormat='Stabilitet: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.RequiredHoldSeconds, StringFormat='Hold-mål: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.VoiceSkillTargets, StringFormat='Skills: {0}'}" Margin="0,0,20,4"/>
          </WrapPanel>
          <TextBlock Text="{Binding TargetProfile.PurposeText, StringFormat='Hensikt: {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding TargetProfile.FocusText, StringFormat='Fokus: {0}'}" TextWrapping="Wrap" Foreground="#aaa"/>
          <TextBlock Text="{Binding TargetProfile.SafetyText, StringFormat='Sikkerhet: {0}'}" TextWrapping="Wrap" Foreground="#e8a"/>
          <TextBlock Text="{Binding TargetProfile.CommonMistakesText, StringFormat='Vanlige feil: {0}'}" TextWrapping="Wrap" Foreground="#aaa"
                     IsVisible="{Binding TargetProfile.HasCommonMistakes}"/>
        </StackPanel>
      </Border>

      <!-- Live session content — visible only while a synthetic session is running -->
      <StackPanel IsVisible="{Binding IsRunning}" Spacing="14">

      <!-- Live pitch + status -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Sanntid (syntetisk lyd)" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding CurrentPitch, StringFormat='{}{0:F1}'}" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="Hz" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="#888"/>
          </StackPanel>
          <TextBlock Text="{Binding PitchStatus, StringFormat='Status: {0}'}" FontSize="15"/>
          <TextBlock Text="{Binding TargetPitchMin, StringFormat='Mål min: {0:F0} Hz'}" Foreground="#999"/>
          <TextBlock Text="{Binding TargetPitchMax, StringFormat='Mål maks: {0:F0} Hz'}" Foreground="#999"/>
        </StackPanel>
      </Border>

      <!-- Runtime pitch chart (converter-free; no OxyPlot). Canvas coords are px-from-bottom. -->
      <Border BorderBrush="#36c" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Pitch-graf (sanntid, syntetisk)" FontWeight="SemiBold" Foreground="#9bf"/>
          <Grid ColumnDefinitions="Auto,*">
            <!-- Y-axis labels: max at top, min at bottom -->
            <Grid Grid.Column="0" Width="44" Height="{Binding RuntimeChart.ChartHeightPx}"
                  RowDefinitions="Auto,*,Auto" Margin="0,0,6,0">
              <TextBlock Grid.Row="0" Text="{Binding RuntimeChart.ChartMaxPitch, StringFormat='{}{0:F0} Hz'}" Foreground="#888" FontSize="11"/>
              <TextBlock Grid.Row="2" Text="{Binding RuntimeChart.ChartMinPitch, StringFormat='{}{0:F0} Hz'}" Foreground="#888" FontSize="11"/>
            </Grid>
            <!-- Chart surface -->
            <Border Grid.Column="1" Background="#11151c" CornerRadius="4" ClipToBounds="True">
              <Canvas Name="ChartCanvas" Height="{Binding RuntimeChart.ChartHeightPx}" HorizontalAlignment="Stretch">
                <!-- Target band (green) -->
                <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding RuntimeChart.TargetBandBottomPx}"
                           Height="{Binding RuntimeChart.TargetBandHeightPx}"
                           Width="{Binding #ChartCanvas.Bounds.Width}" Fill="#3343c25a"/>
                <!-- Recent pitch trace (newest at right) -->
                <ItemsControl Canvas.Left="0" Canvas.Bottom="0" ItemsSource="{Binding RuntimePitchSamples}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle Width="3" Margin="1,0" Fill="#4FC3F7" VerticalAlignment="Bottom" Height="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Current pitch marker (yellow line) -->
                <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding RuntimeChart.CurrentPitchMarkerPx}"
                           Height="2" Width="{Binding #ChartCanvas.Bounds.Width}" Fill="#FFD54F"
                           IsVisible="{Binding RuntimeChart.HasVoice}"/>
              </Canvas>
            </Border>
          </Grid>
          <WrapPanel>
            <TextBlock Text="{Binding RuntimeChart.CurrentPitch, StringFormat='Nå: {0:F1} Hz'}" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding RuntimeChart.TargetPitchMin, StringFormat='Mål: {0:F0}'}" Foreground="#9c9"/>
            <TextBlock Text="{Binding RuntimeChart.TargetPitchMax, StringFormat='–{0:F0} Hz'}" Foreground="#9c9" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding RuntimeChart.ChartStatusText}" Foreground="#aaa"/>
          </WrapPanel>
          <TextBlock Text="Gul linje = nåværende pitch · grønt felt = målområde (kun visning)" Foreground="#666" FontSize="11"/>
        </StackPanel>
      </Border>

      <!-- Live feedback (local, display-only — NOT FeedbackConsistencyGuard/SmartCoach) -->
      <Border BorderBrush="#5a3" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="2">
          <TextBlock Text="Sanntids-tilbakemelding (kun visning)" FontWeight="SemiBold" Foreground="#7b5"/>
          <TextBlock Text="{Binding LiveFeedbackMessage}" TextWrapping="Wrap" FontSize="16"/>
          <TextBlock Text="{Binding LiveFeedbackSeverity, StringFormat='Status: {0}'}" Foreground="#9a9" FontSize="12"/>
        </StackPanel>
      </Border>

      <!-- Hold progress (display-only): derived vs coordinator -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Hold i målområdet (visning)" FontWeight="SemiBold"/>
          <TextBlock Text="Avledet hold" Foreground="#9cf" FontSize="12"/>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding DerivedHoldVisualPercent}" Height="16"/>
          <TextBlock Text="{Binding HoldSeconds, StringFormat='Holdt: {0:F1} s'}" FontSize="12"/>
          <TextBlock Text="Koordinator-hold (kun visning, ikke håndhevet)" Foreground="#d9f" FontSize="12" Margin="0,6,0,0"/>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding CoordinatorHoldVisualPercent}" Height="16"/>
          <TextBlock Text="{Binding HoldComparisonText, StringFormat='Differanse: {0}'}" Foreground="#aaa" FontSize="12"/>
        </StackPanel>
      </Border>

      <!-- Coordinator readout (DISPLAY-ONLY — parameterless ExerciseIntelligenceCoordinator, NOT enforced) -->
      <Border BorderBrush="#a6a" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Koordinator-readout" FontWeight="SemiBold" Foreground="#d9f"/>
          <TextBlock Text="{Binding CoordinatorReadout.ReadoutMode}" Foreground="#999" FontSize="12"/>
          <WrapPanel>
            <TextBlock Text="{Binding CoordinatorReadout.IsCoordinatorActive, StringFormat='Aktiv: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding CoordinatorReadout.CoordinatorStatusText, StringFormat='Tilstand: {0}'}" Margin="0,0,20,4"/>
          </WrapPanel>
          <TextBlock Text="Koordinator-hold vs. avledet hold:" Foreground="#bbb"/>
          <WrapPanel>
            <TextBlock Text="{Binding CoordinatorReadout.CoordinatorHoldProgressPercent, StringFormat='Koordinator: {0:F0}%'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding CoordinatorReadout.CoordinatorHoldSeconds, StringFormat='({0:F1} s)'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding CoordinatorReadout.DerivedHoldProgressPercent, StringFormat='Avledet: {0:F0}%'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding CoordinatorReadout.DerivedHoldSeconds, StringFormat='({0:F1} s)'}" Margin="0,0,20,4"/>
          </WrapPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding CoordinatorReadout.CoordinatorHoldProgressPercent}" Height="14"/>
          <TextBlock Text="{Binding CoordinatorReadout.HoldDifferenceDisplay, StringFormat='Differanse: {0}'}" Foreground="#aaa"/>
          <TextBlock Text="{Binding CoordinatorReadout.CoordinatorGuidanceText}" TextWrapping="Wrap"/>
          <Border Background="#3a2a3a" CornerRadius="4" Padding="8">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding CoordinatorReadout.CoordinatorSafetyLockDisplay}" Foreground="#f9c" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding CoordinatorReadout.CoordinatorRawStateSummary}" Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Runtime status -->
      <Border BorderBrush="#5a3" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="2">
          <TextBlock Text="Veiledning" FontWeight="SemiBold" Foreground="#7b5"/>
          <TextBlock Text="{Binding RuntimeStatusMessage}" TextWrapping="Wrap" FontSize="15"/>
        </StackPanel>
      </Border>

      </StackPanel>
      <!-- /Live session content -->

      <!-- Lifecycle controls + display-only state (synthetic; never saved) -->
      <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="8">
          <WrapPanel>
            <TextBlock Text="{Binding PhaseText, StringFormat='Tilstand: {0}'}" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock Text="{Binding RecommendedDurationText}" Foreground="{DynamicResource ShellMutedBrush}" Margin="0,0,20,0"/>
            <TextBlock Text="{Binding ElapsedText, StringFormat='Tid: {0}'}" Foreground="{DynamicResource ShellMutedBrush}"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Start" Command="{Binding BeginCommand}" IsEnabled="{Binding !IsRunning}" Width="100"/>
            <Button Content="Stopp" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Width="100"/>
          </StackPanel>

          <!-- Inactive: before first Start -->
          <Border IsVisible="{Binding IsInactive}" BorderBrush="{DynamicResource ShellAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <TextBlock Text="Klar til å starte — trykk Start for en syntetisk, visning-bare kjøring."
                       TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
          </Border>

          <!-- Stopped: display-only session-ended summary -->
          <Border IsVisible="{Binding IsStopped}" BorderBrush="{DynamicResource ShellOkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Økt avsluttet" FontWeight="SemiBold" Foreground="{DynamicResource ShellOkBrush}"/>
              <TextBlock Text="{Binding SessionEndedSummary}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding NotSavedNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
