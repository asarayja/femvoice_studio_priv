<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FemVoice.Avalonia.Views.ExerciseRuntimeView">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="← Tilbake" Command="{Binding BackCommand}"/>
        <TextBlock Text="{Binding SelectedExerciseName}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Exercise metadata -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="12">
        <WrapPanel>
          <TextBlock Text="{Binding Category, StringFormat='Kategori: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding Difficulty, StringFormat='Nivå: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding TargetPitchText, StringFormat='Målområde: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding ElapsedText, StringFormat='Tid: {0}'}" Margin="0,0,20,4"/>
        </WrapPanel>
      </Border>

      <!-- Target profile (read-only, display-only — from shared ExerciseTargetProfile) -->
      <Border BorderBrush="#36c" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Mål-profil" FontWeight="SemiBold" Foreground="#9bf"/>
          <TextBlock Text="{Binding TargetProfile.ProfileStatusMessage}" Foreground="#bbb"/>
          <WrapPanel>
            <TextBlock Text="{Binding TargetProfile.TargetPitch, StringFormat='Mål-pitch: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.ResonanceTarget, StringFormat='Resonans-mål: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.StabilityTarget, StringFormat='Stabilitet: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.RequiredHoldSeconds, StringFormat='Hold-mål: {0}'}" Margin="0,0,20,4"/>
            <TextBlock Text="{Binding TargetProfile.VoiceSkillTargets, StringFormat='Skills: {0}'}" Margin="0,0,20,4"/>
          </WrapPanel>
          <TextBlock Text="{Binding TargetProfile.PurposeText, StringFormat='Hensikt: {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding TargetProfile.FocusText, StringFormat='Fokus: {0}'}" TextWrapping="Wrap" Foreground="#aaa"/>
          <TextBlock Text="{Binding TargetProfile.SafetyText, StringFormat='Sikkerhet: {0}'}" TextWrapping="Wrap" Foreground="#e8a"/>
          <TextBlock Text="{Binding TargetProfile.CommonMistakesText, StringFormat='Vanlige feil: {0}'}" TextWrapping="Wrap" Foreground="#aaa"
                     IsVisible="{Binding TargetProfile.HasCommonMistakes}"/>
        </StackPanel>
      </Border>

      <!-- Live pitch + status -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Sanntid (syntetisk lyd)" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding CurrentPitch, StringFormat='{}{0:F1}'}" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="Hz" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="#888"/>
          </StackPanel>
          <TextBlock Text="{Binding PitchStatus, StringFormat='Status: {0}'}" FontSize="15"/>
          <TextBlock Text="{Binding TargetPitchMin, StringFormat='Mål min: {0:F0} Hz'}" Foreground="#999"/>
          <TextBlock Text="{Binding TargetPitchMax, StringFormat='Mål maks: {0:F0} Hz'}" Foreground="#999"/>
        </StackPanel>
      </Border>

      <!-- Hold progress (display-only) -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Hold i målområdet (visning)" FontWeight="SemiBold"/>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding HoldProgressPercent}" Height="18"/>
          <TextBlock Text="{Binding HoldSeconds, StringFormat='Holdt: {0:F1} s'}"/>
        </StackPanel>
      </Border>

      <!-- Runtime status -->
      <Border BorderBrush="#5a3" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="2">
          <TextBlock Text="Veiledning" FontWeight="SemiBold" Foreground="#7b5"/>
          <TextBlock Text="{Binding RuntimeStatusMessage}" TextWrapping="Wrap" FontSize="15"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Stopp" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Width="100"/>
        <Button Content="Start på nytt" Command="{Binding BeginCommand}" IsEnabled="{Binding !IsRunning}" Width="120"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
