<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FemVoice.Avalonia.Views.ExerciseGuideView">
  <!-- WPF-parity Exercise Guide list. Per row, WPF shows: icon · name · goal chip + difficulty • duration ·
       frequency chip · trimmed description · per-exercise session count ("N økter") + chevron. It does NOT show
       a target-pitch (Hz) value in the list (that lives on the exercise page). There is a top "today's progress"
       summary (minutes + sessions). Progress/counts here are DISPLAY-ONLY placeholders (0) — this preview has no
       session persistence/analytics (clearly labelled). Whole-row click opens the exercise. Dark baseline. -->
  <Grid Margin="20" RowDefinitions="Auto,Auto,*">
    <TextBlock Grid.Row="0" Text="{Binding Heading}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"
               Foreground="{DynamicResource ShellHeadingBrush}"/>

    <!-- Today's progress summary (WPF parity) — display-only; this preview does not track/save progress -->
    <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="4">
        <TextBlock Text="Dagens fremgang" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
        <TextBlock Text="{Binding TodaysProgressText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
        <TextBlock Text="{Binding ProgressNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Exercises}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Whole row is a button: click/tap anywhere (or Enter/Space when focused) opens the exercise. -->
            <Button Classes="guideCard" Margin="0,0,0,10" ToolTip.Tip="Åpne øvelsen"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenExerciseCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Purple icon accent badge -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,12,0"
                        Background="{DynamicResource ShellPrimaryBrush}">
                  <TextBlock Text="♪" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellHeadingBrush}"/>
                  <!-- Goal chip + difficulty • duration (no target-pitch Hz in the list — WPF parity) -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip" VerticalAlignment="Center">
                      <TextBlock Text="{Binding GoalText}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="11"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"
                               Text="{Binding DifficultyText}"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12" Text="•"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"
                               Text="{Binding DurationText}"/>
                    <Border Classes="chip" VerticalAlignment="Center">
                      <TextBlock Text="{Binding FrequencyText}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="11"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding ShortDescription}" Foreground="{DynamicResource ShellBodyTextBrush}"
                             TextTrimming="CharacterEllipsis" MaxLines="2"/>
                </StackPanel>
                <!-- Right: per-exercise session count (display-only) + chevron affordance -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" Margin="10,0,0,0">
                  <TextBlock Text="{Binding SessionCountText}" Foreground="{DynamicResource ShellAccentBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                  <TextBlock Text="›" Foreground="{DynamicResource ShellAccentBrush}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
