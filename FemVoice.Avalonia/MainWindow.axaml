<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
        xmlns:views="clr-namespace:FemVoice.Avalonia.Views"
        x:Class="FemVoice.Avalonia.MainWindow"
        Width="980" Height="700"
        Title="FemVoice Studio — Avalonia">
  <DockPanel>
    <!-- Lightweight top navigation (no nav framework) -->
    <Border DockPanel.Dock="Top" Background="#1b1b1b" Padding="10,8" BorderBrush="#333" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}"/>
        <Button Content="Øvelsesguide" Command="{Binding ShowGuideCommand}"/>
      </StackPanel>
    </Border>

    <ContentControl Content="{Binding CurrentPage}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:MainDashboardViewModel"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="vm:ExerciseGuideViewModel"><views:ExerciseGuideView/></DataTemplate>
        <DataTemplate DataType="vm:ExerciseDetailViewModel"><views:ExerciseDetailView/></DataTemplate>
        <DataTemplate DataType="vm:ExerciseRuntimeViewModel"><views:ExerciseRuntimeView/></DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</Window>
