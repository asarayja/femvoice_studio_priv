<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Output/apphost name = the product ("FemVoice.Studio.exe" on Windows, "FemVoice.Studio" on Linux/macOS),
         not the project name. RootNamespace is pinned to the project name so code/XAML namespaces stay
         FemVoice.Avalonia.* (they intentionally shadow Avalonia.*); only the produced file name changes. -->
    <AssemblyName>FemVoice.Studio</AssemblyName>
    <RootNamespace>FemVoice.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Reflection bindings for this first slice (WPF-like, robust). Tighten to compiled bindings
         with x:DataType in a later slice. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Cross-platform desktop packaging readiness (behavior-neutral; affects `dotnet publish` only).
       RuntimeIdentifiers is PLURAL, so it enables RID-targeted publish/restore but does NOT force a RID on
       the default `dotnet build` / `dotnet run` (which stay portable, unchanged). Trimming is explicitly
       DISABLED because the Avalonia head uses reflection bindings (AvaloniaUseCompiledBindingsByDefault=false),
       so a trimmed publish would break bindings. SelfContained is left unset — the publish command chooses it
       via the self-contained publish flag. Windows RIDs are included so the Avalonia head can also produce a
       Windows build (the WPF app remains the frozen Windows reference; this makes Avalonia the cross-platform
       Windows path). No mobile RID here — Android has its own head (FemVoice.Android). See
       FemVoice.Avalonia/Packaging/README.md. -->
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <PublishTrimmed>false</PublishTrimmed>
    <Product>FemVoice Studio</Product>
    <AssemblyTitle>FemVoice Studio (Avalonia desktop)</AssemblyTitle>
    <Version>0.1.3</Version>
    <InformationalVersion>0.1.0-dev (Avalonia desktop preview — display-only)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <!-- Offscreen UI snapshots (the snapshot dev utility): renders pages to PNG with no visible window, so UI
         work can be visually verified when the screen is locked / headless / in CI. Managed-only; not used by the
         normal GUI or the smokes. -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- Security: pin the transitive Tmds.DBus.Protocol (pulled by Avalonia.FreeDesktop 11.2.1 = 0.20.0)
         to the lowest patched version that resolves NU1903 / GHSA-xrw6-gwf8-vvr9. Avalonia 11.2.x
         still ships 0.20.0; the Avalonia-side fix only lands in 11.3.x, so we pin the transitive
         directly here rather than take a wider Avalonia minor bump. Remove this once Avalonia is
         upgraded to a line that already references a patched Tmds.DBus.Protocol. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desktop head = thin Exe (Program.cs entry + smokes + snapshot). The shared UI (App, views, VMs, themes,
         localization, DI) lives in FemVoice.Avalonia.UI, which transitively brings FemVoice.Core +
         FemVoice.Audio.Abstractions. No direct Core/Abstractions ref needed here. -->
    <ProjectReference Include="..\FemVoice.Avalonia.UI\FemVoice.Avalonia.UI.csproj" />
  </ItemGroup>

</Project>
