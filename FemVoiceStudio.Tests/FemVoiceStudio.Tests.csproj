<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FemVoiceStudio\FemVoiceStudio.csproj" />
  </ItemGroup>

  <!-- Shared test-support files. Their single source of truth lives in FemVoice.Tests.Portable;
       they are LINKED (compiled) into this Windows test assembly too because the Windows-only test
       set still uses them after the portable-test split (separate assemblies => no type conflict).
       TestDatabaseService: used by StressSensitiveExperienceTests/ReportExportViewModelTests/etc.
       *TestCollection: preserve the DisableParallelization collections (e.g. ReportExportViewModelTests
       uses [Collection("ReportVerification")]). Mechanical wiring only — no behaviour change. -->
  <ItemGroup>
    <Compile Include="..\FemVoice.Tests.Portable\TestDatabaseService.cs" Link="TestDatabaseService.cs" />
    <Compile Include="..\FemVoice.Tests.Portable\LocalizationTestCollection.cs" Link="LocalizationTestCollection.cs" />
    <Compile Include="..\FemVoice.Tests.Portable\ReportVerificationTestCollection.cs" Link="ReportVerificationTestCollection.cs" />
  </ItemGroup>

  <!-- Temporarily exclude tests with pre-existing issues -->
  <!--
  <ItemGroup>
    <Compile Remove="ExerciseFeedbackEngineTests.cs" />
    <Compile Remove="SmartCoachDecisionTests.cs" />
    <Compile Remove="SafetyLockTests.cs" />
    <Compile Remove="TestDatabaseService.cs" />
  </ItemGroup>
  -->

</Project>
