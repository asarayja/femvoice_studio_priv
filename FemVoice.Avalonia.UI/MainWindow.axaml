<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FemVoice.Avalonia.Views"
        x:Class="FemVoice.Avalonia.MainWindow"
        Width="1100" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellWindowBackgroundBrush}"
        Icon="avares://FemVoice.Avalonia.UI/Assets/logo.ico"
        Title="FemVoice Studio">
  <!-- Desktop window chrome only; the shell itself is the shared ShellView (also used by the Android single-view
       head). Keeps the window Background on a named theme brush. Display-only; no clinical/WPF change. -->
  <views:ShellView/>
</Window>
