<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.TimelinePanelView">
  <!-- REAL voice-development timeline: trend windows (period, composite mean, session count, direction) assembled
       read-only from saved sessions via the frozen Core report pipeline. Exportable (PDF/CSV/JSON). No writes. -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource ShellHeadingBrush}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="{Binding BackLabel}" Classes="secondary" Command="{Binding BackCommand}"/>
      </Grid>

      <Border Classes="card" IsVisible="{Binding !HasReport}">
        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}"/>
      </Border>

      <StackPanel Spacing="16" IsVisible="{Binding HasReport}">
        <!-- Export -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{loc:Tr Key=Report_Export, Fallback=Eksporter}" VerticalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
          <Button Content="PDF" Classes="secondary" Click="OnExportPdf"/>
          <Button Content="CSV" Classes="secondary" Click="OnExportCsv"/>
          <Button Content="JSON" Classes="secondary" Click="OnExportJson"/>
          <TextBlock x:Name="ExportStatus" VerticalAlignment="Center" IsVisible="False"
                     Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Classes="card" BorderBrush="{DynamicResource ShellSuccessBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ReportTitle}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Direction}" Foreground="{DynamicResource ShellAccentBrush}"/>
                      </Grid>
                      <TextBlock Text="{Binding Period}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}"/>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
