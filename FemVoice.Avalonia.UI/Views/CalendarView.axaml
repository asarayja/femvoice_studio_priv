<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.CalendarView">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="900" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
      <Border Classes="card" IsVisible="{Binding !EngineAvailable}" BorderBrush="{DynamicResource ShellWarningBrush}">
        <TextBlock Text="{Binding UnavailableNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>
      <Border Classes="card" IsVisible="{Binding EngineAvailable}">
        <StackPanel Spacing="6">
          <TextBlock Text="Ingen registrerte økter siste 90 dager." IsVisible="{Binding !HasDays}"
                     Foreground="{DynamicResource ShellMutedBrush}"/>
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CalendarDayItem">
                <!-- Each day is a clickable button opening that day's details -->
                <Button Command="{Binding Open}" Classes="nav" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}" MinWidth="120"/>
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{DynamicResource ShellBodyTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource ShellMutedBrush}" FontSize="16" Margin="8,0,0,0"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding DataNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
