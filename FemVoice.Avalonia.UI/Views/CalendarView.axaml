<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.CalendarView">
  <!-- Month-grid calendar (WPF CalendarWindow parity): weekday headers + prev/next/today + day cells that
       highlight today and training days (session marks); click a day with sessions to open its details. -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="760" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>

      <Border Classes="card" IsVisible="{Binding !EngineAvailable}" BorderBrush="{DynamicResource ShellWarningBrush}">
        <TextBlock Text="{Binding UnavailableNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <Border Classes="card" IsVisible="{Binding EngineAvailable}">
        <StackPanel Spacing="10">
          <!-- Month navigation -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Content="‹" Classes="nav" Width="40" Command="{Binding PrevMonthCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding MonthLabel}" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ShellAccentBrush}"/>
            <Button Grid.Column="2" Content="{Binding TodayLabel}" Classes="secondary" Command="{Binding GoTodayCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Content="›" Classes="nav" Width="40" Command="{Binding NextMonthCommand}"/>
          </Grid>

          <!-- Weekday headers -->
          <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Day cells (6×7) -->
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CalendarDayCell">
                <Button Command="{Binding Open}" Classes="nav" Margin="2" Padding="0" Height="52"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        ToolTip.Tip="{Binding Tooltip}">
                  <Grid Margin="2">
                    <!-- Intensity heat-map fill (WPF CalendarDay.IntensityColor) -->
                    <Border Background="{Binding IntensityBrush}" CornerRadius="4"/>
                    <!-- Today highlight ring (converter-free: bound to IsToday) -->
                    <Border IsVisible="{Binding IsToday}" BorderBrush="{DynamicResource ShellAccentBrush}" BorderThickness="1.5" CornerRadius="4"/>
                    <Grid RowDefinitions="*,Auto" Margin="4">
                      <TextBlock Grid.Row="0" Text="{Binding DayNumber}" FontSize="13"
                                 Opacity="{Binding NumberOpacity}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                      <TextBlock Grid.Row="1" Text="{Binding SessionMark}" FontSize="12" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource ShellAccentBrush}" FontWeight="Bold"/>
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Intensity legend (WPF parity): the session-intensity colour scale -->
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
            <TextBlock Text="{Binding LegendHeading, StringFormat='{}{0}:'}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <ItemsControl ItemsSource="{Binding Legend}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="{Binding DataNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
