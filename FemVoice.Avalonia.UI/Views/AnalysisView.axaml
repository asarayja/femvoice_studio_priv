<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.AnalysisView">
  <!-- Analysis / Resonance — structural parity with the WPF AnalysisWindow (header band · 4-card stats row ·
       2-column chart-card grid), but DISPLAY-ONLY over SYNTHETIC in-memory sample data. Converter-free mini
       bar-charts (no OxyPlot); no database/history reads, no export, no clinical scoring. Real analysis-engine
       + OxyPlot parity + session data remain deferred (Phase 10). -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16" MaxWidth="1040" HorizontalAlignment="Center">

      <!-- Header band (WPF: heading + subtitle) -->
      <Border Classes="card" Padding="20,16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding Subtitle}"
                     FontSize="14" Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"/>
          <!-- Per-session summary (WPF Analysis "Økt-sammendrag") -->
          <TextBlock IsVisible="{Binding HasSessionSummary}" Text="{Binding SessionSummary}" Margin="0,4,0,0"
                     FontSize="13" Foreground="{DynamicResource ShellBodyTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Top stats row (WPF: 4 stat cards — big value + label) -->
      <ItemsControl ItemsSource="{Binding SummaryMetrics}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:AnalysisSummaryMetric">
            <Border Classes="card" Margin="4,0" Padding="12,14">
              <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Score components (WPF parity): per-dimension averages -->
      <Border Classes="card" IsVisible="{Binding HasScoreComponents}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ScoreComponentsHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}"/>
          <ItemsControl ItemsSource="{Binding ScoreComponents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:AnalysisSummaryMetric">
                <Grid ColumnDefinitions="160,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource ShellMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Sample-data / not-persisted banner -->
      <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBlock Text="{Binding SampleDataNotice}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- Chart cards (WPF: 2-column grid of chart cards; here converter-free mini bar-charts) -->
      <ItemsControl ItemsSource="{Binding Series}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:AnalysisSeries">
            <Border Classes="card" Margin="4">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
                <!-- Converter-free mini bar-chart: bottom-aligned rectangles, Height = px sample value -->
                <Border Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="4" Height="150" ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding Bars}" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Rectangle Width="7" Margin="2,0" Fill="{DynamicResource ShellAccentBrush}" VerticalAlignment="Bottom" Height="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Deferred analysis actions (inert: disabled, no command) -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Importer analyse (senere)" IsEnabled="False" Padding="10,4"/>
        <Button Content="Eksporter analyse (senere)" IsEnabled="False" Padding="10,4"/>
      </StackPanel>

      <TextBlock Text="Trender beregnes fra dine lagrede økter. Import/eksport av analyse kommer senere."
                 Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
