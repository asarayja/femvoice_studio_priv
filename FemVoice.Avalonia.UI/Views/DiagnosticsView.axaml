<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.DiagnosticsView">
  <!-- FUNCTIONAL diagnostics: real runtime + database status, real diagnostics-text export (native save dialog in
       code-behind), real database backup, and the on-disk data-folder path. No deferred placeholder cards. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20" Spacing="16" MaxWidth="1040" HorizontalAlignment="Center">

      <!-- Header band -->
      <Border Classes="card" Padding="20,16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding Intro}" FontSize="14" Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Real system status (runtime + database facts) + real actions -->
      <Border Classes="card" IsVisible="{Binding HasStatus}" BorderBrush="{DynamicResource ShellSuccessBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding StatusHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <ItemsControl ItemsSource="{Binding Status}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="180,*" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource ShellMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource ShellBodyTextBrush}" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Data folder path (so the user knows where files live) -->
          <Grid ColumnDefinitions="180,*" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Text="{Binding DataFolderLabel}" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding DataFolderPath}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>
          </Grid>

          <!-- Real actions: export diagnostics text + database backup -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="ExportButton" Content="{Binding ExportLabel}" Classes="primary" Click="OnExportClick"/>
            <Button Content="{Binding BackupLabel}" Classes="secondary" Command="{Binding BackupCommand}"/>
          </StackPanel>
          <TextBlock x:Name="ExportStatus" IsVisible="False"
                     Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ActionStatus}" IsVisible="{Binding HasActionStatus}"
                     Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
