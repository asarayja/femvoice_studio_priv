<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.ManualOverridePanelView">
  <!-- SAFETY-CRITICAL manual override: a professional enters an intended profile; the FROZEN two-stage clamp runs
       and ONLY the clamped outcome is shown (never the raw intent). Display-only: no persistence, no application. -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="760" HorizontalAlignment="Center">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource ShellHeadingBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Content="{Binding BackLabel}" Classes="secondary" Command="{Binding BackCommand}"/>
      </Grid>

      <Border Classes="card">
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="13"/>
      </Border>

      <!-- Intended request (raw intent) -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Ønsket profil (forespørsel)" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}"/>
          <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Baseline-profil" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" MinWidth="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding ProfileTypes}" SelectedItem="{Binding BaselineProfileType, Mode=TwoWay}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stilmål" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" MinWidth="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding StyleGoals}" SelectedItem="{Binding StyleGoal, Mode=TwoWay}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ønsket resonans min" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1" Margin="0,3" MinWidth="180" HorizontalAlignment="Left" Increment="10"
                           Value="{Binding IntendedResonanceMin, Mode=TwoWay}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ønsket resonans max" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" Margin="0,3" MinWidth="180" HorizontalAlignment="Left" Increment="10"
                           Value="{Binding IntendedResonanceMax, Mode=TwoWay}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ønsket stabilitetsterskel" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <NumericUpDown Grid.Row="4" Grid.Column="1" Margin="0,3" MinWidth="180" HorizontalAlignment="Left" Increment="0.05" Minimum="0" Maximum="1"
                           Value="{Binding IntendedStabilityThreshold, Mode=TwoWay}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Sikkerhetsgate blokkert" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,3" IsChecked="{Binding SimulateGateBlocked, Mode=TwoWay}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Restitusjonsgrad" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,3" MinWidth="180" HorizontalAlignment="Left"
                      ItemsSource="{Binding RecoverySeverities}" SelectedItem="{Binding RecoverySeverity, Mode=TwoWay}"/>
          </Grid>
          <Button Content="{Binding EvaluateLabel}" Classes="primary" Command="{Binding EvaluateCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- Clamped outcome (the ONLY thing shown) -->
      <Border Classes="card" BorderBrush="{DynamicResource ShellSuccessBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="Klampet utfall (sikkerhet)" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding OutcomeText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
          <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resonansmål (min–max)" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppliedResonance}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stabilitetsterskel" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppliedStability}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Krevd holdetid" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AppliedHold}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ble klampet" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WasClamped}" Foreground="{DynamicResource ShellAccentBrush}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Persist the clamped result to the override audit log (safety store) -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{Binding PersistLabel}" Classes="secondary" Command="{Binding PersistCommand}" IsEnabled="{Binding CanPersist}"/>
            <TextBlock Text="{Binding PersistStatus}" VerticalAlignment="Center" Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel IsVisible="{Binding HasRecent}" Spacing="2">
            <TextBlock Text="{Binding RecentHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}" FontSize="13" Margin="0,4,0,0"/>
            <ItemsControl ItemsSource="{Binding RecentOverrides}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBlock Text="{Binding SafetyNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
