<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FemVoice.Avalonia.Views.SmartCoachView">
  <!-- Engine-backed SmartCoach: the REAL Core SmartCoachEngine's daily recommendation on the REAL database. -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="960" HorizontalAlignment="Center">

      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>

      <!-- Unavailable (no DB / engine error) -->
      <Border Classes="card" IsVisible="{Binding !EngineAvailable}" BorderBrush="{DynamicResource ShellWarningBrush}">
        <TextBlock Text="{Binding UnavailableNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- Engine-backed content -->
      <StackPanel Spacing="14" IsVisible="{Binding EngineAvailable}">

        <!-- Health warning (safety first) -->
        <Border Classes="card" IsVisible="{Binding HasHealthWarning}" BorderBrush="{DynamicResource ShellDangerBrush}">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding HealthWarningHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellDangerBrush}"/>
            <TextBlock Text="{Binding HealthWarningText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
          </StackPanel>
        </Border>

        <!-- Today's recommendation -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding TodaysFocusHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{DynamicResource ShellChipBackgroundBrush}" CornerRadius="6" Padding="8,3">
                <TextBlock Text="{Binding FocusLabel, StringFormat='Fokus: {0}'}" Foreground="{DynamicResource ShellAccentBrush}" FontWeight="SemiBold"/>
              </Border>
              <Border Background="{DynamicResource ShellChipBackgroundBrush}" CornerRadius="6" Padding="8,3">
                <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <!-- Complete today's recommendation (persisted via SaveDailyRecommendation, WPF parity) -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="{Binding CompleteLabel}" Command="{Binding CompleteRecommendationCommand}"
                      IsEnabled="{Binding CanComplete}" IsVisible="{Binding !IsRecommendationCompleted}"/>
              <Border Background="{DynamicResource ShellChipBackgroundBrush}" CornerRadius="6" Padding="10,4"
                      IsVisible="{Binding IsRecommendationCompleted}">
                <TextBlock Text="{Binding CompletedLabel}" Foreground="{DynamicResource ShellSuccessBrush}" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Progress toward goals (WPF parity): pitch/resonance/intonation bars + baseline confidence -->
        <Border Classes="card" IsVisible="{Binding HasProgressToGoal}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ProgressToGoalHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" >
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PitchProgressLabel}" Foreground="{DynamicResource ShellMutedBrush}" VerticalAlignment="Center"/>
              <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PitchProgress}" Height="12" Margin="0,3" Foreground="{DynamicResource ShellAccentBrush}"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ResonanceProgressLabel}" Foreground="{DynamicResource ShellMutedBrush}" VerticalAlignment="Center"/>
              <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ResonanceProgress}" Height="12" Margin="0,3" Foreground="{DynamicResource ShellAccentBrush}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding IntonationProgressLabel}" Foreground="{DynamicResource ShellMutedBrush}" VerticalAlignment="Center"/>
              <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding IntonationProgress}" Height="12" Margin="0,3" Foreground="{DynamicResource ShellAccentBrush}"/>
            </Grid>
            <TextBlock Foreground="{DynamicResource ShellMutedBrush}" FontSize="12" Text="{Binding BaselineConfidenceDisplay}"/>
          </StackPanel>
        </Border>

        <!-- Weekly target + status -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="Ukesmål og status" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <TextBlock Text="{Binding WeeklyTargetText}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}"/>
          </StackPanel>
        </Border>

        <!-- Detail metrics (ported from WPF SmartCoachDetailView): streak, sessions/time this week, consistency -->
        <Border Classes="card" IsVisible="{Binding HasDetail}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding DetailHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <ItemsControl ItemsSource="{Binding DetailMetrics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="200,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource ShellMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding WeeklyHistoryHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding WeeklyHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="200,*" Margin="0,1">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource ShellMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding DataNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
