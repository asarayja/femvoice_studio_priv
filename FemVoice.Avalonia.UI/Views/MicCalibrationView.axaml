<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             x:Class="FemVoice.Avalonia.Views.MicCalibrationView">
  <!-- REAL microphone CALIBRATION wizard (ports the WPF MicrophoneCalibrationWindow): device list + a two-phase
       guided flow (measure silence → measure comfortable voice), then the FROZEN Core MicrophoneCalibrationService
       assesses quality and, when usable, builds + SAVES the adaptive profile. Live RMS/dBFS meter + progress during
       each phase. Stops capture on navigate-away (IDisposable). No threshold math here — all in the frozen service. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Center">

      <!-- Header -->
      <Border Classes="card" Padding="20,16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding Intro}" FontSize="13" Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Device + guided controls -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="90,*" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="{Binding DeviceLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="320"
                      ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      IsEnabled="{Binding IsAvailable}"/>
          </Grid>

          <!-- Current-step instruction -->
          <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>

          <!-- Primary action (label changes per step) + restart once complete -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="{Binding PrimaryActionLabel}" Command="{Binding NextCommand}"
                    IsEnabled="{Binding CanRecord}" IsVisible="{Binding !IsComplete}"/>
            <Button Classes="secondary" Content="{Binding RestartLabel}" Command="{Binding RestartCommand}"
                    IsVisible="{Binding IsComplete}"/>
          </StackPanel>

          <!-- Capture progress -->
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"
                       IsVisible="{Binding Capturing}" Foreground="{DynamicResource ShellAccentBrush}"/>

          <!-- Live level meter (during a phase) -->
          <StackPanel Spacing="6" IsVisible="{Binding Capturing}">
            <TextBlock Text="{Binding LevelLabel}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
            <Border Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="4" Height="24" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Level}" Height="24"
                           Foreground="{DynamicResource ShellAccentBrush}" Background="Transparent"/>
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" Text="{loc:Tr Key=ExRun_Lbl_Level, Fallback='Nivå'}"/>
                <TextBlock Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" Text=": "/>
                <TextBlock Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" Text="{Binding Level, StringFormat='{}{0:F0}'}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11"
                         Text="{Binding PeakLevel, StringFormat='Topp: {0:F0}'}"/>
            </Grid>
            <TextBlock Text="{Binding LiveLevelText}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>

          <!-- Measured-silence summary (after step 1) -->
          <TextBlock Text="{Binding NoiseSummary}" IsVisible="{Binding NoiseSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="{DynamicResource ShellSubtleTextBrush}" FontSize="12" TextWrapping="Wrap"/>

          <!-- Result / quality / saved-profile message -->
          <Border IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  BorderBrush="{DynamicResource ShellOkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
          </Border>

          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ShellSuccessBrush}" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
