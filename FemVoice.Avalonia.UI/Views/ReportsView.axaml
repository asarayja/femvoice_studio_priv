<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.ReportsView">
  <!-- FUNCTIONAL Reports: real progress-summary preview + session history + CSV/text export (native save dialog in
       code-behind) + the real professional panels (coach/clinician/timeline/case-review, each PDF/CSV/JSON). No
       deferred placeholder cards. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20" Spacing="16" MaxWidth="1040" HorizontalAlignment="Center">

      <!-- Header band -->
      <Border Classes="card" Padding="20,16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding Intro}" FontSize="14" Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Real progress-summary report preview (from the real database) + CSV/text export -->
      <Border Classes="card" IsVisible="{Binding HasPreview}" BorderBrush="{DynamicResource ShellSuccessBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding PreviewBody}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" FontFamily="monospace"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="ExportCsvButton" Content="{Binding ExportLabel}" Classes="primary"
                    IsEnabled="{Binding CanExport}" Click="OnExportCsvClick"/>
            <Button x:Name="ExportTextButton" Content="{Binding ExportTextLabel}" Classes="secondary"
                    IsEnabled="{Binding CanExport}" Click="OnExportTextClick"/>
          </StackPanel>
          <TextBlock x:Name="ExportStatus" IsVisible="False"
                     Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Professional panels (all real; each assembled read-only from saved data, exportable to PDF/CSV/JSON) -->
      <Border Classes="card" IsVisible="{Binding HasProfessionalPanels}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding ProfessionalHeading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
          <WrapPanel>
            <Button Content="{Binding OpenCoachLabel}" Classes="secondary" Margin="0,0,8,8"
                    IsVisible="{Binding CanOpenCoachPanel}" Command="{Binding OpenCoachCommand}"/>
            <Button Content="{Binding OpenClinicianLabel}" Classes="secondary" Margin="0,0,8,8"
                    IsVisible="{Binding CanOpenClinicianPanel}" Command="{Binding OpenClinicianCommand}"/>
            <Button Content="{Binding OpenTimelineLabel}" Classes="secondary" Margin="0,0,8,8"
                    IsVisible="{Binding CanOpenTimelinePanel}" Command="{Binding OpenTimelineCommand}"/>
            <Button Content="{Binding OpenCaseReviewLabel}" Classes="secondary" Margin="0,0,8,8"
                    IsVisible="{Binding CanOpenCaseReviewPanel}" Command="{Binding OpenCaseReviewCommand}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Real session history (from saved sessions) -->
      <Border Classes="card" IsVisible="{Binding HasHistory}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding HistoryHeading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
          <ItemsControl ItemsSource="{Binding ExportRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ReportExportRow">
                <TextBlock Text="{Binding Display}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"
                           FontFamily="monospace" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
