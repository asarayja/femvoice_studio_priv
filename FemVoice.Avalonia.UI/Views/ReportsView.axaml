<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.ReportsView">
  <!-- Reports / professional tools — WPF-style hub layout (header band + 2-column card grid), DISPLAY-ONLY:
       static placeholder cards + disabled actions. No report generation, no file dialogs, no database/history,
       no clinical calc. Real report export + clinician/coach/case-review remain deferred (Phase 11). -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16" MaxWidth="1040" HorizontalAlignment="Center">

      <!-- Header band -->
      <Border Classes="card" Padding="20,16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="Visning-bare rapporter og fagverktøy — ingen generering, eksport eller historikk."
                     FontSize="14" Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Real progress-summary report preview (from the real database) -->
      <Border Classes="card" IsVisible="{Binding HasPreview}" BorderBrush="{DynamicResource ShellSuccessBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding PreviewBody}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" FontFamily="monospace"/>
          <TextBlock Text="Ekte sammendrag fra dine lagrede økter. Fullstendig rapportgenerering og eksport (PDF/CSV) kommer senere."
                     Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Deferred / not-saved banner (professional tools + export remain deferred) -->
      <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBlock Text="{Binding ScaffoldNotice}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- Disabled, inert global actions (no command, no file dialog) -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Eksporter (senere)" IsEnabled="False" Padding="10,4"/>
        <Button Content="Åpne rapport (senere)" IsEnabled="False" Padding="10,4"/>
      </StackPanel>

      <!-- 2-column grid of report / professional-tool cards -->
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ReportsCard">
            <Border Classes="card" Margin="4">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Border Grid.Column="1" Background="{DynamicResource ShellChipBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11"/>
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
                <!-- Inert per-card action: disabled, bound to the row's false flag, no command -->
                <Button Content="Åpne (senere)" IsEnabled="{Binding IsEnabled}" Padding="10,3" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Rapporter/profesjonelle verktøy er en visning-bare plassholder — ingen ekte rapport, eksport, lagring eller fagverktøy."
                 Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
