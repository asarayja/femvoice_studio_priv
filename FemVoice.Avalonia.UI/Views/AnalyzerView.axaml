<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             x:Class="FemVoice.Avalonia.Views.AnalyzerView">
  <!-- REAL real-time analyzer: live main frequency + resonance vs a target, plus running pitch stats (avg/min/max/
       duration/samples). Core pitch + resonance engines. Measurement only — no scoring/persistence. IDisposable. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Center">

      <Border Classes="card" Padding="20,16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding Intro}" FontSize="13" Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DeviceLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" HorizontalAlignment="Stretch" MaxWidth="320"
                      ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TargetLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,3" HorizontalAlignment="Stretch" MaxWidth="320" Increment="5" Minimum="80" Maximum="500"
                           Value="{Binding TargetFrequency, Mode=TwoWay}"/>
          </Grid>
          <!-- Musical-note target picker (WPF Analyzer parity): sets the target frequency -->
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding SelectFrequencyLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
            <ItemsControl ItemsSource="{Binding NoteOptions}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="secondary" Content="{Binding Label}" Margin="0,0,6,6" MinWidth="52"
                          Command="{Binding $parent[ItemsControl].DataContext.SelectNoteCommand}" CommandParameter="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="{Binding StartLabel}" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}" IsEnabled="{Binding IsAvailable}"/>
            <Button Classes="secondary" Content="{Binding StopLabel}" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"/>
          </StackPanel>

          <!-- Live spectrum (real FFT) with the WPF spectrogram overlay: target line, main-freq line, F1/F2 markers -->
          <StackPanel Spacing="4" IsVisible="{Binding IsRunning}">
            <TextBlock Text="{Binding SpectrumHeading}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
            <Border Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="4" Padding="4" Height="98"
                    HorizontalAlignment="Left" ClipToBounds="True">
              <Panel Width="{Binding SpectrumWidthPx}">
                <ItemsControl ItemsSource="{Binding SpectrumBars}" VerticalAlignment="Bottom">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="6" Height="{Binding}" VerticalAlignment="Bottom" Background="{DynamicResource ShellAccentBrush}" CornerRadius="1"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Overlay marker lines (positioned by frequency → px) -->
                <Canvas>
                  <Rectangle Canvas.Top="0" Width="2" Height="90" Fill="{DynamicResource ShellSuccessBrush}" Opacity="0.9"
                             Canvas.Left="{Binding TargetMarkerPx}" IsVisible="{Binding HasTargetMarker}"/>
                  <Rectangle Canvas.Top="0" Width="2" Height="90" Fill="{DynamicResource ShellMarkerBrush}"
                             Canvas.Left="{Binding MainFreqMarkerPx}" IsVisible="{Binding HasMainFreqMarker}"/>
                  <Rectangle Canvas.Top="0" Width="2" Height="90" Fill="{DynamicResource ShellWarningBrush}" Opacity="0.8"
                             Canvas.Left="{Binding FormantF1MarkerPx}" IsVisible="{Binding HasF1Marker}"/>
                  <Rectangle Canvas.Top="0" Width="2" Height="90" Fill="{DynamicResource ShellWarningBrush}" Opacity="0.55"
                             Canvas.Left="{Binding FormantF2MarkerPx}" IsVisible="{Binding HasF2Marker}"/>
                </Canvas>
              </Panel>
            </Border>
            <!-- Live formant readouts (F1/F2/F3) beside the spectrogram (WPF Analyzer) -->
            <Grid ColumnDefinitions="Auto,*,*,*" IsVisible="{Binding IsRunning}">
              <TextBlock Grid.Column="0" Text="{Binding FormantsHeading, StringFormat='{}{0}:'}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding FormantF1, StringFormat='F1 {0}'}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="{Binding FormantF2, StringFormat='F2 {0}'}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="{Binding FormantF3, StringFormat='F3 {0}'}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
            </Grid>
          </StackPanel>

          <!-- Live readouts -->
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding MainFreqLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding MainFrequency, StringFormat='{}{0:F1}'}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
                <TextBlock Text="Hz" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="{DynamicResource ShellMutedBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding TargetDeltaText}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding ResonanceLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding ResonanceText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ShellSuccessBrush}" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Running statistics -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding StatsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Key=Dashboard_AveragePitch, Fallback='Snitt tonehøyde'}" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AveragePitch, StringFormat='{}{0:F0} Hz'}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MinPitch, StringFormat='{}{0:F0} Hz'}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Maksimum" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MaxPitch, StringFormat='{}{0:F0} Hz'}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Varighet" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DurationText}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Key=Analyzer_VoicedMeasurements, Fallback='Stemte målinger'}" Foreground="{DynamicResource ShellMutedBrush}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SampleCount}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Quantiles + range distribution (WPF Analyzer parity) — computed over the full recording on Stop -->
      <Border Classes="card" IsVisible="{Binding HasDistribution}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding QuantilesHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}"/>
            <ItemsControl ItemsSource="{Binding Quantiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="140,*" Margin="0,1">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource ShellMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding RangeHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}"/>
            <ItemsControl ItemsSource="{Binding RangeDistribution}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="180,*,48" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
                    <!-- Visual bar (WPF Analyzer range distribution shows bars) -->
                    <Border Grid.Column="1" HorizontalAlignment="Left" Height="12" VerticalAlignment="Center"
                            Width="{Binding BarPx}" Background="{DynamicResource ShellAccentBrush}" CornerRadius="2"/>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
