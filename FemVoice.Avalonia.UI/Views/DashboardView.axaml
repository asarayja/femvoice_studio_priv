<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             x:Class="FemVoice.Avalonia.Views.DashboardView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">

      <!-- Header (concise — the long developer note lives in docs, not the UI) -->
      <StackPanel Spacing="2">
        <TextBlock Text="{loc:Tr Key=Main_TrainingForFeminineVoice, Fallback='Trening for feminin stemme'}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{DynamicResource ShellHeadingBrush}"/>
        <TextBlock Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"
                   Text="Trykk Start for live tonehøyde, stabilitet og helse fra mikrofonen."/>
      </StackPanel>

      <!-- Top cards: side-by-side on wide, stacked on narrow (responsive in code-behind). -->
      <Grid x:Name="TopCards" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

        <!-- Session controls -->
        <Border x:Name="SessionCard" Grid.Row="0" Grid.Column="0" Classes="card" Margin="0,0,6,0">
          <StackPanel Spacing="10">
            <TextBlock Text="Økt" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <WrapPanel>
              <Button Content="{loc:Tr Key=UI_StartSession, Fallback='Start Økt'}" Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRecording}" MinWidth="100" Margin="0,0,8,6"/>
              <Button Content="{loc:Tr Key=UI_StopSession, Fallback='Stopp Økt'}" Command="{Binding StopCommand}" IsEnabled="{Binding IsRecording}" MinWidth="90" Margin="0,0,8,6"/>
              <TextBlock VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding IsRecording, StringFormat='Tar opp: {0}'}"/>
            </WrapPanel>
            <WrapPanel>
              <TextBlock VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource ShellBodyTextBrush}" Text="Vanskelighetsgrad:"/>
              <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding SelectedDifficultyOption}" MinWidth="140" MaxWidth="220" Margin="0,0,0,6"
                        DisplayMemberBinding="{Binding Label}"/>
            </WrapPanel>
            <!-- Synthetic test-tone selector: only relevant when no real microphone is available (hidden otherwise). -->
            <WrapPanel IsVisible="{Binding IsSyntheticBackend}">
              <TextBlock VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource ShellBodyTextBrush}" Text="Syntetisk testlyd:"/>
              <ComboBox ItemsSource="{Binding SyntheticAudioModes}" SelectedItem="{Binding SyntheticAudioMode}" MinWidth="140" MaxWidth="220" Margin="0,0,0,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Live metrics -->
        <Border x:Name="LiveCard" Grid.Row="0" Grid.Column="1" Classes="card" Margin="6,0,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Sanntid" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <!-- Comfort-zone COMPLIANCE (no raw Hz — WPF principle A7). The green highlight = in the comfort zone. -->
            <Border CornerRadius="4" Padding="10,6" HorizontalAlignment="Left"
                    Background="{DynamicResource ShellChartBackgroundBrush}">
              <TextBlock Text="{Binding ComfortZoneStatus}" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource ShellAccentBrush}"/>
            </Border>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding CurrentSignalStatus, StringFormat='Signal: {0}'}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding PitchStability, StringFormat='Stabilitet: {0}'}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding ResonanceDisplay, StringFormat='Resonans: {0}'}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding HealthStatusDisplay, StringFormat='Helse: {0}'}"/>
            <!-- The comfort zone is shown as a band in the graph below (not a numeric Hz target). -->
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellSuccessBrush}" Text="{Binding ComfortZoneLabel}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Feedback -->
      <Border Classes="card" BorderBrush="{DynamicResource ShellSuccessBrush}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding FeedbackHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellSuccessBrush}"/>
          <TextBlock Text="{Binding CurrentFeedbackMessage}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource ShellBodyTextBrush}"/>
        </StackPanel>
      </Border>

      <!-- Pitch trace: converter-free Canvas chart (comfort-zone band + grid + scaled trace + current marker +
           y-axis labels). px == "distance from bottom" via the shared RuntimeChartDisplay geometry. No third-party charting lib. -->
      <Border Classes="card" MinHeight="260">
        <Grid RowDefinitions="Auto,*">
          <!-- No raw Hz (WPF principle A7): title + axis communicate direction, not numeric frequency. -->
          <TextBlock Grid.Row="0" Text="Tonehøyde (nyeste til høyre)" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <!-- Y-axis direction labels: higher at top, lower at bottom (qualitative, no Hz numerals) -->
            <Grid Grid.Column="0" Width="46" Height="{Binding DashboardChart.ChartHeightPx}" RowDefinitions="Auto,*,Auto" Margin="0,0,6,0">
              <TextBlock Grid.Row="0" Text="Høyere" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11"/>
              <TextBlock Grid.Row="2" Text="Lavere" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11"/>
            </Grid>
            <!-- Plot surface -->
            <Border Grid.Column="1" Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="6" ClipToBounds="True">
              <Panel>
                <Canvas Name="DashChartCanvas" Height="{Binding DashboardChart.ChartHeightPx}" HorizontalAlignment="Stretch">
                  <!-- Subtle horizontal grid lines -->
                  <Rectangle Canvas.Left="0" Canvas.Bottom="50"  Height="1" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                  <Rectangle Canvas.Left="0" Canvas.Bottom="100" Height="1" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                  <Rectangle Canvas.Left="0" Canvas.Bottom="150" Height="1" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                  <!-- Comfort-zone band (green, around the target range) -->
                  <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding DashboardChart.TargetBandBottomPx}"
                             Height="{Binding DashboardChart.TargetBandHeightPx}"
                             Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellTargetBandBrush}"/>
                  <!-- Pitch trace (newest at right), scaled into the axis -->
                  <ItemsControl Canvas.Left="0" Canvas.Bottom="0" ItemsSource="{Binding PitchTracePx}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Rectangle Width="3" Margin="1,0" Fill="{DynamicResource ShellChartTraceBrush}" VerticalAlignment="Bottom" Height="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Current-pitch marker line -->
                  <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding DashboardChart.CurrentPitchMarkerPx}"
                             Height="2" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellMarkerBrush}"
                             IsVisible="{Binding DashboardChart.HasVoice}"/>
                </Canvas>
                <!-- Empty-state hint (centered, subtle) when not recording -->
                <TextBlock Text="Tonehøyde vises her under opptak" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource ShellFaintBrush}" IsVisible="{Binding !IsRecording}"/>
              </Panel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Mobile-only Stop bar: on phone widths, while recording, a clear full-width Stop button placed AFTER the
           graph so it never overlaps other controls (the top Start/Stop stay for desktop). Shown only when the layout
           is compact (code-behind) AND recording. -->
      <Border x:Name="MobileStopBar" IsVisible="False" Background="Transparent">
        <Button Content="Stopp økt" Classes="primary" Command="{Binding StopCommand}" IsVisible="{Binding IsRecording}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12" FontSize="16"/>
      </Border>

      <!-- "Din progresjon" block (WPF parity) — real level/streak/totals from the DB when available -->
      <Border Classes="card" IsVisible="{Binding HasProgression}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ProgressionHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding ProgTotalLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding ProgTotalSessions}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding ProgStreakLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding ProgStreak}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="{Binding ProgLevelLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding ProgLevelName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgPercent}" Height="14" Foreground="{DynamicResource ShellAccentBrush}"/>
          <TextBlock Text="{Binding ProgToNext}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
        </StackPanel>
      </Border>

      <!-- Recent local sessions (real saved TrainingSessions from the local database; display-only, no clinical change). -->
      <Border Classes="card" IsVisible="{Binding HasRecentSessions}">
        <StackPanel Spacing="6">
          <TextBlock Text="Siste økter (lokalt)" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <ItemsControl ItemsSource="{Binding RecentSessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Lagres lokalt i din database på denne maskinen — ingen klinisk endring."
                     Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
