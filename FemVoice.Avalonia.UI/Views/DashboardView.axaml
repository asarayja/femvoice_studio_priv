<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             x:Class="FemVoice.Avalonia.Views.DashboardView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">

      <!-- Header (concise — the long developer note lives in docs, not the UI) -->
      <StackPanel Spacing="2">
        <TextBlock Text="{loc:Tr Key=Main_TrainingForFeminineVoice, Fallback='Trening for feminin stemme'}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{DynamicResource ShellHeadingBrush}"/>
        <TextBlock Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"
                   Text="{loc:Tr Key=Dash_Subtitle, Fallback='Trykk Start for live tonehøyde, stabilitet og helse fra mikrofonen.'}"/>
      </StackPanel>

      <!-- Daily training reminder (in-app nudge): a humane "today's session is still owed" banner. Only shown when the
           opt-in reminder is Due (past the preferred time, none logged today, weekly goal not yet met). Short copy +
           a direct Start so it's one tap from the intent. -->
      <Border Classes="card" IsVisible="{Binding ShowReminder}" BorderBrush="{DynamicResource ShellSuccessBrush}"
              Background="{DynamicResource ShellChartBackgroundBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding ReminderHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellSuccessBrush}" FontSize="13"/>
            <TextBlock Text="{Binding ReminderMessage}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Text="{Binding ReminderStreakNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}"
                       IsVisible="{Binding ReminderStreakNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
          <Button Grid.Column="1" Content="{loc:Tr Key=UI_StartSession, Fallback='Start Økt'}" Classes="primary"
                  Command="{Binding StartCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
      </Border>

      <!-- Session controls (full width). Mid-session this collapses to just Stop + a "Tar opp" indicator so the
           reading text + pitch graph below are what you see. -->
      <Border x:Name="SessionCard" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{loc:Tr Key=Dash_Session, Fallback='Økt'}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <WrapPanel>
            <Button Content="{loc:Tr Key=UI_StartSession, Fallback='Start Økt'}" Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRecording}" MinWidth="100" Margin="0,0,8,6" IsVisible="{Binding !IsRecording}"/>
            <Button Content="{loc:Tr Key=UI_StopSession, Fallback='Stopp Økt'}" Classes="primary" Command="{Binding StopCommand}" IsEnabled="{Binding IsRecording}" MinWidth="90" Margin="0,0,8,6" IsVisible="{Binding IsRecording}"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource ShellSuccessBrush}" Text="{loc:Tr Key=Dash_Recording, Fallback='● Tar opp'}" IsVisible="{Binding IsRecording}"/>
          </WrapPanel>
          <!-- Pre-start choices (difficulty + synthetic test tone) — hidden while recording. -->
          <WrapPanel IsVisible="{Binding !IsRecording}">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{loc:Tr Key=Dash_Difficulty, Fallback='Vanskelighetsgrad:'}"/>
            <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding SelectedDifficultyOption}" MinWidth="140" MaxWidth="220" Margin="0,0,0,6"
                      DisplayMemberBinding="{Binding Label}"/>
          </WrapPanel>
          <WrapPanel IsVisible="{Binding IsSyntheticBackend}">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{loc:Tr Key=Dash_SyntheticTone, Fallback='Syntetisk testlyd:'}" IsVisible="{Binding !IsRecording}"/>
            <ComboBox ItemsSource="{Binding SyntheticAudioModes}" SelectedItem="{Binding SyntheticAudioMode}" MinWidth="140" MaxWidth="220" Margin="0,0,0,6" IsVisible="{Binding !IsRecording}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Exercise text (WPF front-page parity): a sentence to READ at the current difficulty + a difficulty badge.
           Sentences come from the shared Core ExerciseTextService; "Neste tekst" cycles them. -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding ExerciseTextHeading}" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource ShellHeadingBrush}"/>
            <Border Classes="chip" VerticalAlignment="Center">
              <TextBlock Text="{Binding ExerciseDifficultyBadge}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="11"/>
            </Border>
            <TextBlock Text="{Binding CurrentExerciseCategory}" VerticalAlignment="Center"
                       Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
          </StackPanel>
          <TextBlock Text="{Binding CurrentExerciseTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{DynamicResource ShellAccentBrush}"/>
          <!-- The sentence to read aloud -->
          <Border Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="6" Padding="12">
            <TextBlock Text="{Binding CurrentExerciseText}" TextWrapping="Wrap" FontSize="16" LineHeight="24"
                       Foreground="{DynamicResource ShellBodyTextBrush}"/>
          </Border>
          <Button Content="{Binding NextExerciseLabel}" Classes="secondary" Command="{Binding NextExerciseCommand}"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- Pitch trace: converter-free Canvas chart (comfort-zone band + grid + scaled trace + current marker +
           y-axis labels). px == "distance from bottom" via the shared RuntimeChartDisplay geometry. No third-party charting lib. -->
      <Border Classes="card" MinHeight="260">
        <Grid RowDefinitions="Auto,*">
          <!-- No raw Hz (WPF principle A7): title + axis communicate direction, not numeric frequency. -->
          <TextBlock Grid.Row="0" Text="{loc:Tr Key=Dash_PitchChartTitle, Fallback='Tonehøyde (nyeste til høyre)'}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <!-- Y-axis direction labels: higher at top, lower at bottom (qualitative, no Hz numerals) -->
            <Grid Grid.Column="0" Width="46" Height="{Binding DashboardChart.ChartHeightPx}" RowDefinitions="Auto,*,Auto" Margin="0,0,6,0">
              <TextBlock Grid.Row="0" Text="{loc:Tr Key=Dash_AxisHigher, Fallback='Høyere'}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11"/>
              <TextBlock Grid.Row="2" Text="{loc:Tr Key=Dash_AxisLower, Fallback='Lavere'}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11"/>
            </Grid>
            <!-- Plot surface -->
            <Border Grid.Column="1" Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="6" ClipToBounds="True">
              <Panel>
                <Canvas Name="DashChartCanvas" Height="{Binding DashboardChart.ChartHeightPx}" HorizontalAlignment="Stretch">
                  <!-- Subtle horizontal grid lines -->
                  <Rectangle Canvas.Left="0" Canvas.Bottom="50"  Height="1" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                  <Rectangle Canvas.Left="0" Canvas.Bottom="100" Height="1" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                  <Rectangle Canvas.Left="0" Canvas.Bottom="150" Height="1" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                  <!-- Comfort-zone band (green, around the target range) -->
                  <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding DashboardChart.TargetBandBottomPx}"
                             Height="{Binding DashboardChart.TargetBandHeightPx}"
                             Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellTargetBandBrush}"/>
                  <!-- Pitch trace (newest at right), scaled into the axis -->
                  <ItemsControl Canvas.Left="0" Canvas.Bottom="0" ItemsSource="{Binding PitchTracePx}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Rectangle Width="3" Margin="1,0" Fill="{DynamicResource ShellChartTraceBrush}" VerticalAlignment="Bottom" Height="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Current-pitch marker line -->
                  <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding DashboardChart.CurrentPitchMarkerPx}"
                             Height="2" Width="{Binding #DashChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellMarkerBrush}"
                             IsVisible="{Binding DashboardChart.HasVoice}"/>
                </Canvas>
                <!-- Empty-state hint (centered) when not recording — readable muted, not faint -->
                <TextBlock Text="{loc:Tr Key=Dash_PitchEmptyHint, Fallback='Tonehøyde vises her under opptak'}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="14" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding !IsRecording}"/>
              </Panel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Perceived-voice mirror: the headline "how does my voice read right now?" answer (masculine/androgynous/
           feminine) from pitch + resonance, with the two ingredient scores shown (honest, not a black box) and the
           single most useful next step. Visible while recording; values update live. -->
      <Border Classes="card" IsVisible="{Binding IsRecording}" BorderBrush="{DynamicResource ShellAccentBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PerceptionHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <!-- Big band reading -->
          <TextBlock Text="{Binding PerceptionLabel}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                     Foreground="{DynamicResource ShellAccentBrush}"/>
          <!-- Combined 0–100 reading -->
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding PerceptionScore}" Height="12"
                       Foreground="{DynamicResource ShellAccentBrush}"/>
          <!-- The two ingredients (transparency) -->
          <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasPerception}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding PerceptionPitchLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding PerceptionPitchScore}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding PerceptionResonanceLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding PerceptionResonanceScore}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <!-- Highest-leverage next step -->
          <TextBlock Text="{Binding PerceptionTip}" TextWrapping="Wrap" FontSize="14"
                     Foreground="{DynamicResource ShellBodyTextBrush}" IsVisible="{Binding HasPerception}"/>
          <!-- Honesty note: an estimate, not a verdict -->
          <TextBlock Text="{Binding PerceptionExplainer}" TextWrapping="Wrap" FontSize="11"
                     Foreground="{DynamicResource ShellFaintBrush}"/>
        </StackPanel>
      </Border>

      <!-- Live metrics (Sanntid) — below the graph so text + pitch trace stay the priority. -->
      <Border x:Name="LiveCard" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Tr Key=Dash_LiveHeading, Fallback='Sanntid'}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <Border CornerRadius="4" Padding="10,6" HorizontalAlignment="Left"
                  Background="{DynamicResource ShellChartBackgroundBrush}">
            <TextBlock Text="{Binding ComfortZoneStatus}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ShellAccentBrush}"/>
          </Border>
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text="{loc:Tr Key=Dash_SignalLabel, Fallback='Signal'}"/>
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text=": "/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding CurrentSignalStatus}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text="{loc:Tr Key=Dash_StabilityLabel, Fallback='Stabilitet'}"/>
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text=": "/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding PitchStability}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text="{loc:Tr Key=Dash_ResonanceLabel, Fallback='Resonans'}"/>
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text=": "/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding ResonanceDisplay}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text="{loc:Tr Key=Dash_HealthLabel, Fallback='Helse'}"/>
            <TextBlock Foreground="{DynamicResource ShellBodyTextBrush}" Text=": "/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" Text="{Binding HealthStatusDisplay}"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellSuccessBrush}" Text="{Binding ComfortZoneLabel}"/>
        </StackPanel>
      </Border>

      <!-- Feedback -->
      <Border Classes="card" BorderBrush="{DynamicResource ShellSuccessBrush}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding FeedbackHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellSuccessBrush}"/>
          <TextBlock Text="{Binding CurrentFeedbackMessage}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource ShellBodyTextBrush}"/>
        </StackPanel>
      </Border>

      <!-- Mobile-only Stop bar: on phone widths, while recording, a clear full-width Stop button placed AFTER the
           graph so it never overlaps other controls (the top Start/Stop stay for desktop). Shown only when the layout
           is compact (code-behind) AND recording. -->
      <Border x:Name="MobileStopBar" IsVisible="False" Background="Transparent">
        <Button Content="{loc:Tr Key=Dash_StopSession, Fallback='Stopp økt'}" Classes="primary" Command="{Binding StopCommand}" IsVisible="{Binding IsRecording}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12" FontSize="16"/>
      </Border>

      <!-- "Din progresjon" block (WPF parity) — real level/streak/totals from the DB when available -->
      <Border Classes="card" IsVisible="{Binding HasProgression}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ProgressionHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding ProgTotalLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding ProgTotalSessions}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding ProgStreakLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding ProgStreak}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="{Binding ProgLevelLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Text="{Binding ProgLevelName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgPercent}" Height="14" Foreground="{DynamicResource ShellAccentBrush}"/>
          <TextBlock Text="{Binding ProgToNext}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
        </StackPanel>
      </Border>

      <!-- Recent local sessions (real saved TrainingSessions from the local database; display-only, no clinical change). -->
      <Border Classes="card" IsVisible="{Binding HasRecentSessions}">
        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Tr Key=Dash_RecentSessions, Fallback='Siste økter (lokalt)'}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <ItemsControl ItemsSource="{Binding RecentSessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Tr Key=Dash_SafetyNote, Fallback='Lagres lokalt i din database på denne maskinen — ingen klinisk endring.'}"
                     Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
