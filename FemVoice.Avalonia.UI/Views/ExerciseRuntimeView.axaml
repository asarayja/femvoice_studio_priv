<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             x:Class="FemVoice.Avalonia.Views.ExerciseRuntimeView">
  <!-- WPF parity: the exercise guide opens THIS page directly (one page, one Start — no separate detail page,
       no second Start). Pre-start info (focus/purpose/instructions) is shown alongside the session controls;
       pressing Start activates the same page. No pitch graph here (WPF has none). Wording is focus-aware
       (pitch is demoted to a secondary technical detail for non-pitch exercises). Display-only; no clinical/
       domain/WPF change. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20" Spacing="14">

      <!-- Header: back + title -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="← Tilbake" Command="{Binding BackCommand}"/>
        <TextBlock Text="{Binding SelectedExerciseName}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{DynamicResource ShellHeadingBrush}"/>
      </StackPanel>

      <!-- Pre-start context (metadata + guidance) — hidden once you start so the controls + live graph are at the top. -->
      <StackPanel Spacing="14" IsVisible="{Binding !IsRunning}">

      <!-- Focus-aware metadata strip -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <WrapPanel>
            <TextBlock Text="{Binding Category, StringFormat='Kategori: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Text="{Binding Difficulty, StringFormat='Nivå: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <TextBlock Text="{Binding FocusLabel, StringFormat='Fokus: {0}'}" Margin="0,0,20,4" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}"/>
            <TextBlock Text="{Binding DurationText, StringFormat='Varighet: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <!-- Pitch target shown prominently ONLY when pitch is the primary focus -->
            <TextBlock Text="{Binding TargetPitchText, StringFormat='Målområde: {0}'}" Margin="0,0,20,4"
                       Foreground="{DynamicResource ShellBodyTextBrush}" IsVisible="{Binding IsPitchFocused}"/>
          </WrapPanel>
          <!-- For non-pitch exercises, the pitch range is a secondary technical detail (muted) -->
          <TextBlock Text="{Binding SecondaryPitchText}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"
                     IsVisible="{Binding ShowSecondaryPitch}"/>
        </StackPanel>
      </Border>

      <!-- Exercise Guidance panel (WPF ExerciseWindow): purpose/focus/mistakes/safety cards + feedback-mode badge -->
      <Border Classes="card" IsVisible="{Binding HasGuidance}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding GuidanceHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource ShellChipBackgroundBrush}" CornerRadius="6" Padding="8,2" IsVisible="{Binding HasFeedbackMode}">
              <TextBlock Text="{Binding FeedbackModeText}" Foreground="{DynamicResource ShellAccentBrush}" FontSize="12"/>
            </Border>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding GuidanceItems}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      </StackPanel>

      <!-- Single mobile-first column: session controls first (they collapse to Stop while running), then the LIVE
           readouts (graph + feedback + hold) which are what matters mid-session, then the pre-start guidance
           (purpose/steps/profile) which hides once you start. -->
      <StackPanel x:Name="RuntimeCards" Spacing="14">

        <!-- Session controls + lifecycle state -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ElapsedText}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ShellHeadingBrush}"/>
            <WrapPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding PhaseText, StringFormat='Tilstand: {0}'}" FontWeight="SemiBold" Margin="0,0,16,0" Foreground="{DynamicResource ShellAccentBrush}"/>
              <TextBlock Text="{Binding RecommendedDurationText}" Foreground="{DynamicResource ShellMutedBrush}"/>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Center">
              <Button Content="{loc:Tr Key=UI_StartExercise, Fallback='Start øvelse'}" Classes="primary" Command="{Binding BeginCommand}" IsEnabled="{Binding !IsRunning}" IsVisible="{Binding !IsRunning}" MinWidth="120" Margin="0,0,8,0"/>
              <Button Content="Stopp" Classes="primary" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" IsVisible="{Binding IsRunning}" MinWidth="120"/>
            </WrapPanel>

            <!-- Inactive: before first Start -->
            <Border IsVisible="{Binding IsInactive}" BorderBrush="{DynamicResource ShellAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
              <TextBlock Text="{Binding ReadyToStartText}"
                         TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            </Border>

            <!-- Stopped: session-ended summary -->
            <Border IsVisible="{Binding IsStopped}" BorderBrush="{DynamicResource ShellOkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="Økt avsluttet" FontWeight="SemiBold" Foreground="{DynamicResource ShellOkBrush}"/>
                <TextBlock Text="{Binding SessionEndedSummary}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                <TextBlock Text="{Binding NotSavedNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Live status: a numeric readout PLUS the moving pitch trace (scrolls right as you speak, over the green
             target band, with a current-pitch marker). -->
        <Border Classes="card" IsVisible="{Binding IsRunning}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding LiveHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPitchFocused}">
                <TextBlock Text="{Binding CurrentPitch, StringFormat='{}{0:F1}'}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
                <TextBlock Text="Hz" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="{DynamicResource ShellMutedBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding PitchStatus, StringFormat='Status: {0}'}" FontSize="15" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <TextBlock Text="{Binding CurrentResonance, StringFormat='Resonans: {0}'}" FontSize="15" Foreground="{DynamicResource ShellBodyTextBrush}"/>

              <!-- Moving pitch trace (converter-free Canvas; px == distance from bottom). -->
              <TextBlock Text="Tonehøyde (nyeste til høyre)" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}" Margin="0,4,0,0"/>
              <Grid ColumnDefinitions="Auto,*" Height="{Binding RuntimeChart.ChartHeightPx}">
                <Grid Grid.Column="0" Width="46" RowDefinitions="Auto,*,Auto" Margin="0,0,6,0">
                  <TextBlock Grid.Row="0" Text="Høyere" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11"/>
                  <TextBlock Grid.Row="2" Text="Lavere" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11"/>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="6" ClipToBounds="True">
                  <Panel>
                    <Canvas Name="RtChartCanvas" Height="{Binding RuntimeChart.ChartHeightPx}" HorizontalAlignment="Stretch">
                      <!-- Subtle grid lines -->
                      <Rectangle Canvas.Left="0" Canvas.Bottom="50"  Height="1" Width="{Binding #RtChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                      <Rectangle Canvas.Left="0" Canvas.Bottom="100" Height="1" Width="{Binding #RtChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                      <Rectangle Canvas.Left="0" Canvas.Bottom="150" Height="1" Width="{Binding #RtChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellBorderBrush}"/>
                      <!-- Target band (green) -->
                      <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding RuntimeChart.TargetBandBottomPx}"
                                 Height="{Binding RuntimeChart.TargetBandHeightPx}"
                                 Width="{Binding #RtChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellTargetBandBrush}"/>
                      <!-- Live pitch trace (newest at right) -->
                      <ItemsControl Canvas.Left="0" Canvas.Bottom="0" ItemsSource="{Binding RuntimePitchSamples}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Rectangle Width="3" Margin="1,0" Fill="{DynamicResource ShellChartTraceBrush}" VerticalAlignment="Bottom" Height="{Binding}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- Current-pitch marker line -->
                      <Rectangle Canvas.Left="0" Canvas.Bottom="{Binding RuntimeChart.CurrentPitchMarkerPx}"
                                 Height="2" Width="{Binding #RtChartCanvas.Bounds.Width}" Fill="{DynamicResource ShellMarkerBrush}"
                                 IsVisible="{Binding RuntimeChart.HasVoice}"/>
                    </Canvas>
                    <!-- Empty-state hint until a voice is detected -->
                    <TextBlock Text="Si en jevn tone — tonehøyden vises her." HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource ShellFaintBrush}" IsVisible="{Binding !RuntimeChart.HasVoice}"/>
                  </Panel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Live feedback (local, display-only — NOT FeedbackConsistencyGuard/SmartCoach) -->
          <Border Classes="card" BorderBrush="{DynamicResource ShellSuccessBrush}" IsVisible="{Binding IsRunning}">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr Key=LiveFeedback_Title, Fallback='Live-tilbakemelding'}" FontWeight="SemiBold" Foreground="{DynamicResource ShellSuccessBrush}"/>
              <TextBlock Text="{Binding LiveFeedbackMessage}" TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <TextBlock Text="{Binding RuntimeStatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
            </StackPanel>
          </Border>

          <!-- Hold progress (display-only): derived vs coordinator -->
          <Border Classes="card" IsVisible="{Binding IsRunning}">
            <StackPanel Spacing="4">
              <TextBlock Text="Hold i målområdet (visning)" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
              <TextBlock Text="Avledet hold" Foreground="{DynamicResource ShellSecondaryBrush}" FontSize="12"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding DerivedHoldVisualPercent}" Height="16"/>
              <TextBlock Text="{Binding HoldSeconds, StringFormat='Holdt: {0:F1} s'}" FontSize="12" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <TextBlock Text="Koordinator-hold (veiledende)" Foreground="{DynamicResource ShellDeferredTitleBrush}" FontSize="12" Margin="0,6,0,0"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CoordinatorHoldVisualPercent}" Height="16"/>
              <TextBlock Text="{Binding HoldComparisonText, StringFormat='Differanse: {0}'}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
            </StackPanel>
          </Border>

          <!-- Coordinator readout (DISPLAY-ONLY — parameterless ExerciseIntelligenceCoordinator, NOT enforced) -->
          <Border Classes="card" BorderBrush="{DynamicResource ShellDeferredBorderBrush}" IsVisible="{Binding IsRunning}">
            <StackPanel Spacing="6">
              <TextBlock Text="Koordinator-readout" FontWeight="SemiBold" Foreground="{DynamicResource ShellDeferredTitleBrush}"/>
              <TextBlock Text="{Binding CoordinatorReadout.ReadoutMode}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <WrapPanel>
                <TextBlock Text="{Binding CoordinatorReadout.IsCoordinatorActive, StringFormat='Aktiv: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                <TextBlock Text="{Binding CoordinatorReadout.CoordinatorStatusText, StringFormat='Tilstand: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              </WrapPanel>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CoordinatorReadout.CoordinatorHoldProgressPercent}" Height="14"/>
              <TextBlock Text="{Binding CoordinatorReadout.HoldDifferenceDisplay, StringFormat='Differanse: {0}'}" Foreground="{DynamicResource ShellMutedBrush}"/>
              <TextBlock Text="{Binding CoordinatorReadout.CoordinatorGuidanceText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <Border Background="{DynamicResource ShellChartBackgroundBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding CoordinatorReadout.CoordinatorSafetyLockDisplay}" Foreground="{DynamicResource ShellDeferredTitleBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding CoordinatorReadout.CoordinatorRawStateSummary}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

        <!-- Pre-start guidance (focus/purpose, step-by-step, technical profile) — hidden once you start so the live
             readouts above are what you see mid-session. -->
        <StackPanel Spacing="14" IsVisible="{Binding !IsRunning}">

          <!-- Focus + purpose -->
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding FocusSummary}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                         Foreground="{DynamicResource ShellAccentBrush}"/>
              <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding SafetyNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellWarningBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <!-- Instructions / steps -->
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key=Exercise_StepsTitle, Fallback='Steg for steg'}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                      <Ellipse Width="10" Height="10" Fill="{DynamicResource ShellPrimaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Technical target profile (secondary detail) -->
          <Border Classes="card" BorderBrush="{DynamicResource ShellSecondaryBrush}">
            <StackPanel Spacing="4">
              <TextBlock Text="Mål-profil (teknisk)" FontWeight="SemiBold" Foreground="{DynamicResource ShellSecondaryBrush}"/>
              <TextBlock Text="{Binding TargetProfile.ProfileStatusMessage}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <WrapPanel>
                <TextBlock Text="{Binding TargetProfile.TargetPitch, StringFormat='Mål-pitch: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellMutedBrush}"/>
                <TextBlock Text="{Binding TargetProfile.ResonanceTarget, StringFormat='Resonans-mål: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellMutedBrush}"/>
                <TextBlock Text="{Binding TargetProfile.StabilityTarget, StringFormat='Stabilitet: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellMutedBrush}"/>
                <TextBlock Text="{Binding TargetProfile.RequiredHoldSeconds, StringFormat='Hold-mål: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellMutedBrush}"/>
                <TextBlock Text="{Binding MetricsText, StringFormat='Mål-skills: {0}'}" Margin="0,0,20,4" Foreground="{DynamicResource ShellMutedBrush}"/>
              </WrapPanel>
              <TextBlock Text="{Binding TargetProfile.FocusText, StringFormat='Fokus: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}"/>
              <TextBlock Text="{Binding TargetProfile.CommonMistakesText, StringFormat='Vanlige feil: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}"
                         IsVisible="{Binding TargetProfile.HasCommonMistakes}"/>
            </StackPanel>
          </Border>

        </StackPanel>

      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
