<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.DayDetailsView">
  <!-- Day-details: every real training session recorded on the chosen day (from the DB). Read-only. -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding DateDisplay}" FontSize="14" Foreground="{DynamicResource ShellMutedBrush}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding BackLabel}" Classes="secondary" Command="{Binding BackCommand}"/>
      </Grid>

      <Border Classes="card" IsVisible="{Binding !HasSessions}">
        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}"/>
      </Border>

      <StackPanel Spacing="10" IsVisible="{Binding HasSessions}">
        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
        <Border Classes="card">
          <StackPanel Spacing="2">
            <!-- Header row -->
            <Grid ColumnDefinitions="70,80,*,90,90">
              <TextBlock Grid.Column="0" Text="Tid" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="Varighet" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="Tonehøyde" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="Resonans" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="4" Text="Score" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Sessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="70,80,*,90,90" Margin="0,3,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Pitch}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Resonance}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Score}" Foreground="{DynamicResource ShellAccentBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
