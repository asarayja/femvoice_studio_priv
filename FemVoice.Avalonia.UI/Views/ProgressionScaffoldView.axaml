<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FemVoice.Avalonia.Views.ProgressionScaffoldView">
  <!-- DEFERRED, display-only Progression scaffold. Mirrors the WPF ProgressionDashboard visual structure
       (level badge + progress bar + FemVoice-score tile + Resonance/Pitch/Intonation parameter rows) with
       SYNTHETIC "—" placeholders, an empty/disabled progress bar, and a disabled action. No progression
       calculation, no safety gate, no scoring, no persistence. Dark baseline. -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="960" HorizontalAlignment="Center">

      <!-- Header: title + deferred badge -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{DynamicResource ShellHeadingBrush}"/>
        <Border Classes="chip" VerticalAlignment="Center">
          <TextBlock Text="{Binding DeferredBadge}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="11"/>
        </Border>
      </StackPanel>
      <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>

      <!-- Level badge + progress + score -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto" >
          <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top" Margin="0,0,14,0"
                  Background="{DynamicResource ShellPrimaryBrush}">
            <TextBlock Text="{Binding LevelBadge}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="{Binding LevelName}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <TextBlock Text="{Binding LevelDescription}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
            <!-- Empty/disabled progress bar (no real progression) -->
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="8" IsEnabled="False"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Text="{Binding ScoreValue}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ShellAccentBrush}"/>
            <TextBlock Text="{Binding ScoreLabel}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Parameters card: Resonance / Pitch / Intonation (synthetic "—") -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <ItemsControl ItemsSource="{Binding Parameters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="120,*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                  <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="6" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding SyntheticNote}" FontSize="11" Foreground="{DynamicResource ShellFaintBrush}"/>
        </StackPanel>
      </Border>

      <!-- Read-only safety note -->
      <Border Classes="card">
        <TextBlock Text="{Binding SafetyNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- Disabled action (deferred) -->
      <Button Classes="primary" Content="{Binding ActionLabel}" IsEnabled="{Binding ActionEnabled}" HorizontalAlignment="Left"/>

      <TextBlock Text="{Binding Footnote}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ShellFaintBrush}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
