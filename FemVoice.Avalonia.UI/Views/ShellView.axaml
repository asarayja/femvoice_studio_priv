<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             xmlns:views="clr-namespace:FemVoice.Avalonia.Views"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             x:Class="FemVoice.Avalonia.Views.ShellView"
             Background="{DynamicResource ShellWindowBackgroundBrush}">
  <!-- Shared shell for the desktop MainWindow (Window) AND the Android single-view MainView. RESPONSIVE:
       a SplitView nav pane (inline on wide/tablet, overlay+hamburger on phone widths) + content + an info
       sidebar that hides below ~900px. Adaptivity is driven by ShellView.axaml.cs (SizeChanged). Shell colours
       use named theme brushes (Themes/ShellTheme.axaml, Dark/Light). Display-only; no clinical/WPF change. -->
  <DockPanel>

    <!-- Header (hamburger appears only on narrow/phone widths) -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource ShellHeaderBackgroundBrush}" Padding="14,10"
            BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="HamburgerButton" Content="☰" Classes="nav" Width="42" MinWidth="42" Padding="0"
                HorizontalContentAlignment="Center" IsVisible="False" Click="OnHamburgerClick" VerticalAlignment="Center"/>
        <TextBlock Text="FemVoice Studio" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{DynamicResource ShellHeadingBrush}"/>
        <TextBlock Text="{loc:Tr Key=Shell_HeaderSubtitle, Fallback='Avalonia desktop · kun visning'}"
                   FontSize="12" Foreground="{DynamicResource ShellMutedBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Bottom status strip (display-only; no persistence) -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ShellStatusBackgroundBrush}" Padding="12,6"
            BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding MicStatusText}" Foreground="{DynamicResource ShellAccentBrush}" FontSize="12"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ModeText}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
        <TextBlock Text="{Binding CurrentDestinationLabel, StringFormat='Side: {0}'}"
                   HorizontalAlignment="Center" Foreground="{DynamicResource ShellSubtleTextBrush}" FontSize="12"/>
      </DockPanel>
    </Border>

    <!-- Body: responsive nav pane (SplitView) + [content | info sidebar] -->
    <SplitView x:Name="NavSplit" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="220"
               PaneBackground="{DynamicResource ShellPanelBackgroundBrush}">
      <SplitView.Pane>
        <!-- Left navigation rail (implemented destinations + deferred placeholders) -->
        <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0" Padding="10">
          <ScrollViewer>
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key=Shell_NavHeading, Fallback='Navigasjon'}"
                         FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}" Margin="2,0,0,6"/>
              <ItemsControl ItemsSource="{Binding NavItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ShellNavItem">
                    <Button Content="{Binding Label}" Command="{Binding Command}"
                            Classes="nav" Classes.deferred="{Binding !IsImplemented}"
                            Click="OnNavItemClick" Margin="0,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{loc:Tr Key=Shell_NavDeferredHint, Fallback='Flater merket «senere» er visning-bare plassholdere.'}"
                         TextWrapping="Wrap" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" Margin="2,10,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </SplitView.Pane>

      <!-- Content + right info sidebar -->
      <Grid ColumnDefinitions="*,Auto">
        <ContentControl Grid.Column="0" Content="{Binding CurrentPage}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:MainDashboardViewModel"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="vm:ExerciseGuideViewModel"><views:ExerciseGuideView/></DataTemplate>
            <!-- The exercise guide opens the exercise page (runtime) directly — no separate detail page (WPF parity). -->
            <DataTemplate DataType="vm:ExerciseRuntimeViewModel"><views:ExerciseRuntimeView/></DataTemplate>
            <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView/></DataTemplate>
            <DataTemplate DataType="vm:AnalysisViewModel"><views:AnalysisView/></DataTemplate>
            <DataTemplate DataType="vm:ReportsViewModel"><views:ReportsView/></DataTemplate>
            <DataTemplate DataType="vm:DiagnosticsViewModel"><views:DiagnosticsView/></DataTemplate>
            <!-- Deferred, display-only scaffolds (no services, no engines, no side effects) -->
            <DataTemplate DataType="vm:ProgressionScaffoldViewModel"><views:ProgressionScaffoldView/></DataTemplate>
            <DataTemplate DataType="vm:SmartCoachScaffoldViewModel"><views:SmartCoachScaffoldView/></DataTemplate>
            <!-- Engine-backed (real engines on the real DB) -->
            <DataTemplate DataType="vm:SmartCoachViewModel"><views:SmartCoachView/></DataTemplate>
            <DataTemplate DataType="vm:ProgressionViewModel"><views:ProgressionView/></DataTemplate>
            <DataTemplate DataType="vm:StatisticsViewModel"><views:StatisticsView/></DataTemplate>
            <DataTemplate DataType="vm:CalendarViewModel"><views:CalendarView/></DataTemplate>
            <DataTemplate DataType="vm:FirstTimeSetupViewModel"><views:FirstTimeSetupView/></DataTemplate>
            <DataTemplate DataType="vm:MicCalibrationViewModel"><views:MicCalibrationView/></DataTemplate>
            <DataTemplate DataType="vm:CoachPanelViewModel"><views:CoachPanelView/></DataTemplate>
            <DataTemplate DataType="vm:ClinicianPanelViewModel"><views:ClinicianPanelView/></DataTemplate>
            <DataTemplate DataType="vm:TimelinePanelViewModel"><views:TimelinePanelView/></DataTemplate>
            <DataTemplate DataType="vm:ManualOverridePanelViewModel"><views:ManualOverridePanelView/></DataTemplate>
            <DataTemplate DataType="vm:ResonanceViewModel"><views:ResonanceView/></DataTemplate>
            <!-- Static deferred placeholder (no services, no side effects) -->
            <DataTemplate DataType="vm:DeferredSurfaceViewModel">
              <ScrollViewer>
                <StackPanel Margin="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ShellDeferredTitleBrush}"/>
                  <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                  </Border>
                  <!-- Footnote bound from the VM (non-subscribing Localized.Get) since this template is transient. -->
                  <TextBlock Text="{Binding Footnote}"
                             Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- Right info sidebar (static, display-only placeholder; hidden below ~900px) -->
        <Border x:Name="InfoSidebar" Grid.Column="1" Width="260" Background="{DynamicResource ShellPanelBackgroundBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="{loc:Tr Key=Shell_InfoHeading, Fallback='Info'}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>

            <!-- Real quick-stats from the saved sessions (shown when there is data) -->
            <Border IsVisible="{Binding HasInfoStats}" BorderBrush="{DynamicResource ShellOkBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding InfoStatsHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellOkBrush}" FontSize="13"/>
                <TextBlock Text="{Binding InfoSessionsLine}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
                <TextBlock Text="{Binding InfoStreakLine}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
                <TextBlock Text="{Binding InfoLastScoreLine}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
              </StackPanel>
            </Border>
            <!-- Hint shown when there is no data yet -->
            <TextBlock IsVisible="{Binding !HasInfoStats}" Text="{Binding InfoNoStatsHint}"
                       TextWrapping="Wrap" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12"/>

            <!-- Mode/safety posture (accurate: real local data, no clinical change) -->
            <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
              <TextBlock Text="{Binding ModeText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellSubtleTextBrush}" FontSize="12"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </SplitView>
  </DockPanel>
</UserControl>
