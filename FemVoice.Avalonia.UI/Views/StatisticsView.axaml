<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.StatisticsView">
  <!-- Statistics: real training stats from the real database (WPF StatisticsWindow parity). -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="1000" HorizontalAlignment="Center">

      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>

      <Border Classes="card" IsVisible="{Binding !EngineAvailable}" BorderBrush="{DynamicResource ShellWarningBrush}">
        <TextBlock Text="{Binding UnavailableNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <StackPanel Spacing="12" IsVisible="{Binding EngineAvailable}">
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:AnalysisSummaryMetric">
              <Border Classes="card" Width="220" Margin="0,0,10,10" Padding="14">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                  <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Current-level card (WPF parity) -->
        <Border Classes="card" IsVisible="{Binding HasLevel}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding CurrentLevelHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <TextBlock Text="{Binding LevelName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ShellAccentBrush}"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LevelProgressPercent}" Height="14" Foreground="{DynamicResource ShellAccentBrush}"/>
            <TextBlock Text="{Binding LevelProgressText}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
          </StackPanel>
        </Border>

        <!-- Recent-sessions list (WPF parity) -->
        <Border Classes="card" IsVisible="{Binding HasRecentSessions}">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding RecentHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
            <Grid ColumnDefinitions="130,*,90,90">
              <TextBlock Grid.Column="0" Text="Dato" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="Nivå" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="Varighet" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="Score" FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding RecentSessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="130,*,90,90" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding Date}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Difficulty}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Score}" Foreground="{DynamicResource ShellAccentBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding DataNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
