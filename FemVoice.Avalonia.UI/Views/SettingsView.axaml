<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:FemVoice.Avalonia.Localization"
             x:Class="FemVoice.Avalonia.Views.SettingsView">
  <!-- FUNCTIONAL Settings. Every control below is live and persisted (theme/language/motion apply immediately;
       the rest are stored and read by their consumers). No disabled "Utsatt" placeholders. The page DataContext is
       the SettingsViewModel; the working cards bind to its Preferences editor. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="14" MaxWidth="1000" HorizontalAlignment="Center">

      <!-- Header -->
      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ShellHeadingBrush}"/>

      <!-- Local preferences (theme/language/style/focus/frequency/motion) -->
      <Border Classes="card">
        <StackPanel Spacing="8" DataContext="{Binding Preferences}">
          <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
          <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>

          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ThemeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="360" Margin="0,3"
                      ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LanguageLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="360" Margin="0,3"
                      ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language, Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StyleLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="360" Margin="0,3"
                      ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding FocusLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="360" Margin="0,3"
                      ItemsSource="{Binding FocusOptions}" SelectedItem="{Binding SelectedFocus, Mode=TwoWay}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding FrequencyLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="360" Margin="0,3"
                      ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding ReduceMotionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,3" IsChecked="{Binding ReduceMotion, Mode=TwoWay}"/>
          </Grid>

          <WrapPanel>
            <Button Classes="primary" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Margin="0,0,8,8"/>
            <Button Classes="secondary" Content="{Binding ReloadLabel}" Command="{Binding ReloadCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
          <WrapPanel IsVisible="{Binding HasActions}">
            <Button Classes="secondary" Content="{Binding RerunSetupLabel}" Command="{Binding RerunSetupCommand}" Margin="0,0,8,8"/>
            <Button Classes="secondary" Content="{Binding OpenMicCalLabel}" Command="{Binding OpenMicCalibrationCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                     Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Audio and microphone -->
      <Border Classes="card">
        <StackPanel Spacing="8" DataContext="{Binding Preferences}">
          <TextBlock Text="{Binding AudioHeading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding MicDeviceLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="360" Margin="0,3"
                      ItemsSource="{Binding MicDeviceOptions}" SelectedItem="{Binding SelectedMicDevice, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding HearOwnVoiceLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,3" IsChecked="{Binding HearOwnVoice, Mode=TwoWay}"/>
          </Grid>
          <TextBlock Text="{Binding HearOwnVoiceNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11"/>
        </StackPanel>
      </Border>

      <!-- Accessibility + privacy consent toggles -->
      <Border Classes="card">
        <StackPanel Spacing="8" DataContext="{Binding Preferences}">
          <TextBlock Text="{Binding AccessibilityHeading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
          <CheckBox Content="{Binding StressSensitiveLabel}" IsChecked="{Binding StressSensitive, Mode=TwoWay}"/>
          <CheckBox Content="{Binding ReducedVisualLabel}" IsChecked="{Binding ReducedVisualFeedback, Mode=TwoWay}"/>
          <TextBlock Text="{Binding PrivacyHeading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}" Margin="0,6,0,0"/>
          <CheckBox Content="{Binding DiagnosticsConsentLabel}" IsChecked="{Binding DiagnosticsConsent, Mode=TwoWay}"/>
          <CheckBox Content="{Binding ResearchConsentLabel}" IsChecked="{Binding ResearchConsent, Mode=TwoWay}"/>
          <TextBlock Text="{loc:Tr Key=Settings_SaveHint, Fallback='Endringene lagres når du trykker «Lagre» øverst.'}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11"/>
        </StackPanel>
      </Border>

      <!-- Data: real backup / restore / clear -->
      <Border Classes="card">
        <StackPanel Spacing="8" DataContext="{Binding Preferences}">
          <TextBlock Text="{Binding DataHeading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
          <TextBlock Text="{Binding DataNote}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>

          <WrapPanel>
            <Button Classes="secondary" Content="{Binding BackupLabel}" Command="{Binding BackupCommand}" Margin="0,0,8,8"/>
            <ComboBox MinWidth="180" MaxWidth="320" HorizontalAlignment="Left" Margin="0,0,8,8" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                      IsVisible="{Binding HasBackups}" DisplayMemberBinding="{Binding DisplayName}"/>
            <TextBlock Text="{Binding NoBackupsLabel}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12"
                       VerticalAlignment="Center" IsVisible="{Binding !HasBackups}"/>
          </WrapPanel>

          <WrapPanel>
            <Button Classes="secondary" Content="{Binding RestoreLabel}" Command="{Binding RestoreCommand}" IsVisible="{Binding HasBackups}" Margin="0,0,8,8"/>
            <Button Classes="secondary" Content="{Binding ClearLabel}" Command="{Binding ClearCommand}" Margin="0,0,8,8"/>
          </WrapPanel>

          <!-- Inline confirmation for the destructive actions -->
          <Border BorderBrush="{DynamicResource ShellWarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                  IsVisible="{Binding ConfirmRestore}">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Key=Settings_RestoreConfirm, Fallback='Gjenopprett fra valgt sikkerhetskopi? Nåværende data erstattes (en sikkerhetskopi tas først).'}"
                         TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmRestoreActionCommand}"/>
                <Button Classes="secondary" Content="{Binding CancelLabel}" Command="{Binding CancelConfirmCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border BorderBrush="{DynamicResource ShellWarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                  IsVisible="{Binding ConfirmClear}">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Key=Settings_ClearConfirm, Fallback='Tømme hele databasen? All lokal treningshistorikk slettes. Dette kan ikke angres (men du kan gjenopprette fra en sikkerhetskopi).'}"
                         TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmClearActionCommand}"/>
                <Button Classes="secondary" Content="{Binding CancelLabel}" Command="{Binding CancelConfirmCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding DataStatus}" IsVisible="{Binding HasDataStatus}"
                     Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Privacy consent paragraphs (informational; SettingsViewModel context) -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ConsentHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <ItemsControl ItemsSource="{Binding ConsentParagraphs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- About (real) -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding AboutHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource ShellBodyTextBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
            <TextBlock Text="{Binding VersionValue}" Foreground="{DynamicResource ShellBodyTextBrush}" FontSize="12"/>
          </StackPanel>
          <TextBlock Text="{Binding PlatformValue}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding SafetyNote}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
