<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FemVoice.Avalonia.ViewModels"
             x:Class="FemVoice.Avalonia.Views.SettingsView">
  <!-- Display-only Settings scaffold mirroring WPF SettingsWindow sections. Each row renders a DISABLED control
       of its kind (combo/toggle/button) plus an "Utsatt" chip — every control is IsEnabled=False, bound to
       nothing, with no command (no side effects). Dark baseline via shell theme brushes; no value converters. -->
  <ScrollViewer>
    <!-- Layout polish: a centered, wider content column (was narrow + left-aligned) so a wide desktop window is
         used better/balanced; section cards flow into a responsive 1-/2-column WrapPanel. Visual only. -->
    <StackPanel Margin="24" Spacing="12" MaxWidth="1000" HorizontalAlignment="Center">

      <!-- Header: title + deferred badge -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{DynamicResource ShellHeadingBrush}"/>
        <Border Classes="chip" VerticalAlignment="Center">
          <TextBlock Text="{Binding DeferredBadge}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="11"/>
        </Border>
      </StackPanel>

      <!-- Deferred banner -->
      <Border BorderBrush="{DynamicResource ShellDeferredBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBlock Text="{Binding DeferredBanner}" TextWrapping="Wrap" Foreground="{DynamicResource ShellBodyTextBrush}"/>
      </Border>

      <!-- Stage 1: the ONLY interactive section — harmless local UI preferences (theme/language/reduce-motion),
           persisted to an Avalonia-local file. PERSISTENCE ONLY: Save/Reload round-trip the file; nothing is
           applied to the running app (no theme switch, no culture change). The behaviour-heavy sections below
           remain disabled/inert. -->
      <Border Classes="card">
        <StackPanel Spacing="8" DataContext="{Binding Preferences}">
          <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
          <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>

          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ThemeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left" Margin="0,3"
                      ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LanguageLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left" Margin="0,3"
                      ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language, Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ReduceMotionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ShellBodyTextBrush}"/>
            <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,3" IsChecked="{Binding ReduceMotion, Mode=TwoWay}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"/>
            <Button Classes="secondary" Content="{Binding ReloadLabel}" Command="{Binding ReloadCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                     Foreground="{DynamicResource ShellSuccessBrush}" FontSize="12"/>
          <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- One card per settings section — responsive WrapPanel: cards are ~340px so 2 columns engage at normal
           desktop widths (two cards + spacing fit ~700px of content region), and fall back to 1 column when narrow. -->
      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SettingsSection">
            <Border Classes="card" Width="340" Margin="0,0,10,10" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource ShellAccentBrush}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SettingsRow">
                      <!-- Label-above-control so rows stay readable inside the narrower (340px) card. -->
                      <StackPanel Margin="0,6,0,0" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Label}" Foreground="{DynamicResource ShellBodyTextBrush}" VerticalAlignment="Center"/>
                          <!-- Compact "Utsatt" chip on actionable rows -->
                          <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding ShowDeferredChip}">
                            <TextBlock Text="{Binding DeferredChip}" Foreground="{DynamicResource ShellChipTextBrush}" FontSize="10"/>
                          </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <!-- Info: read-only value text -->
                          <TextBlock Text="{Binding Value}" IsVisible="{Binding IsInfo}" Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" VerticalAlignment="Center"/>
                          <!-- Disabled control matching the WPF control kind (all inert) -->
                          <ComboBox IsVisible="{Binding IsCombo}" IsEnabled="False" MinWidth="180" HorizontalAlignment="Left" PlaceholderText="{Binding ControlText}"/>
                          <CheckBox IsVisible="{Binding IsToggle}" IsEnabled="False" Content="{Binding ControlText}"/>
                          <Button IsVisible="{Binding IsButton}" IsEnabled="False" Content="{Binding ControlText}" Padding="12,3"/>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Privacy consent paragraphs (WPF): informational text block, not toggle-row labels -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ConsentHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ShellHeadingBrush}"/>
          <ItemsControl ItemsSource="{Binding ConsentParagraphs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedBrush}" FontSize="12" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding SafetyNote}"
                 Foreground="{DynamicResource ShellFaintBrush}" FontSize="12" TextWrapping="Wrap"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
