<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.1.2" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Linux portable-core split (2026-06-16): the UI-free domain (Models, scoring, SmartCoach,
       health/recovery/progression, analytics, data/SQLite, diagnostics, localization core, audio DSP)
       and the RESX moved to FemVoice.Core (net10.0). This WPF head now references them.
       NOTE: this project targets net10.0-windows + WPF and is built/verified ONLY on Windows.
       The Resources\Strings.resx EmbeddedResource block was removed because the RESX now lives in
       FemVoice.Core (RootNamespace=FemVoiceStudio preserves the manifest base name). -->
  <ItemGroup>
    <ProjectReference Include="..\FemVoice.Core\FemVoice.Core.csproj" />
    <ProjectReference Include="..\FemVoice.Audio.Abstractions\FemVoice.Audio.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
