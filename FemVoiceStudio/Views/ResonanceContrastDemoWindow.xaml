<Window x:Class="FemVoiceStudio.Views.ResonanceContrastDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FemVoiceStudio.Converters"
        Title="{loc:Loc ResonanceContrast_Title}"
        Height="640" Width="560"
        MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundSecondaryBrush}">

    <!-- Optional, NON-SCORED resonance-awareness demo (content only; no audio capture, no
         analysis, no scoring, no progression). All copy comes from localized resources. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="{loc:Loc ResonanceContrast_Title}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{loc:Loc ResonanceContrast_Subtitle}"
                       FontSize="15" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="{loc:Loc ResonanceContrast_Description}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,12,0,0"/>

            <!-- Steps -->
            <Border x:Name="StepsCard"
                    Background="{DynamicResource BackgroundCardBrush}"
                    BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="1" FontWeight="Bold" Width="20"
                                   Foreground="{DynamicResource AccentSecondaryBrush}"/>
                        <TextBlock Text="{loc:Loc ResonanceContrast_StepLarge}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="2" FontWeight="Bold" Width="20"
                                   Foreground="{DynamicResource AccentSecondaryBrush}"/>
                        <TextBlock Text="{loc:Loc ResonanceContrast_StepSmall}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="3" FontWeight="Bold" Width="20"
                                   Foreground="{DynamicResource AccentSecondaryBrush}"/>
                        <TextBlock Text="{loc:Loc ResonanceContrast_NoticeDifference}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Safety -->
            <Border Background="{DynamicResource BackgroundCardBrush}"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="0,12,0,0">
                <TextBlock Text="{loc:Loc ResonanceContrast_Safety}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="StartButton" Content="{loc:Loc ResonanceContrast_StartButton}"
                        Click="OnStart" Style="{DynamicResource PrimaryButtonStyle}"
                        Margin="0,0,12,0"/>
                <Button x:Name="StopButton" Content="{loc:Loc ResonanceContrast_StopButton}"
                        Click="OnStop" Style="{DynamicResource SecondaryButtonStyle}"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- Optional / no-score / not-required notes -->
            <TextBlock Text="{loc:Loc ResonanceContrast_OptionalNote}" TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,16,0,0"/>
            <TextBlock Text="{loc:Loc ResonanceContrast_NoScoreNote}" TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="{loc:Loc ResonanceContrast_NotRequiredNote}" TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="{loc:Loc ResonanceContrast_BigDogSmallDogNote}" TextWrapping="Wrap"
                       FontSize="12" FontStyle="Italic"
                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
